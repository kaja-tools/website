#!/bin/bash
# Deploy every app to Fly.io. Mirrors the CI matrix in .github/workflows/deploy.yml.
# Requires flyctl to be installed and authenticated (fly auth login).
#
# Pass an app name to deploy just one, e.g. `scripts/deploy theatre`.
set -e
cd "$(dirname "$0")/.."

deploy() {
    local name="$1"; shift
    if [[ -n "$ONLY" && "$ONLY" != "$name" ]]; then
        return
    fi
    echo "==> Deploying $name"
    flyctl deploy "$@" --remote-only
}

ONLY="$1"

deploy home         home
deploy theatre      apps/theatre
deploy seating      apps/seating
deploy concierge    apps/concierge
deploy quirks       apps/quirks

echo "Done"
