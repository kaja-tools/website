#!/bin/bash
set -e

# protoc-go version to use
PROTOC_GO_VERSION="v0.2.1"

cd "$(dirname "$0")/.."
BUILD_DIR=$PWD/build
mkdir -p "$BUILD_DIR"

# Check Go is installed
if ! command -v go &> /dev/null; then
    echo "Go is not installed. Please install Go first."
    exit 1
fi

# Install protoc-go (a pure Go protoc; the well-known types are embedded, so
# there is no include directory to install) and the code-gen plugins into
# build/bin
export GOBIN=$BUILD_DIR/bin
go install github.com/wham/protoc-go/cmd/protoc-go@"$PROTOC_GO_VERSION"
go install github.com/twitchtv/twirp/protoc-gen-twirp@latest
go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest
go install google.golang.org/protobuf/cmd/protoc-gen-go@latest

PROTOC_BIN="$GOBIN/protoc-go"

echo "Generating proto files..."

# quirks is the protocol testbed: it speaks Twirp only.
cd "apps/quirks"
# Generate v1 proto files (proto_path=proto so files register as v1/quirks.proto, etc.)
"$PROTOC_BIN" --proto_path=proto --plugin=protoc-gen-go="$GOBIN/protoc-gen-go" --go_out=. --plugin=protoc-gen-twirp="$GOBIN/protoc-gen-twirp" --twirp_out=. $(find proto/v1 -name "*.proto")

# Generate v2 proto files (proto_path=proto so files register as v2/quirks.proto, etc.)
"$PROTOC_BIN" --proto_path=proto --plugin=protoc-gen-go="$GOBIN/protoc-gen-go" --go_out=. --plugin=protoc-gen-twirp="$GOBIN/protoc-gen-twirp" --twirp_out=. $(find proto/v2 -name "*.proto")

cd "../seating"
"$PROTOC_BIN" --proto_path=. --plugin=protoc-gen-go="$GOBIN/protoc-gen-go" --go_out=. --plugin=protoc-gen-grpc="$GOBIN/protoc-gen-go-grpc" --grpc_out=. -Iproto/ $(find . -iname "*.proto")

# concierge is a client of seating, so it generates from seating's proto rather
# than keeping a copy of it.
cd "../concierge"
"$PROTOC_BIN" --plugin=protoc-gen-go="$GOBIN/protoc-gen-go" --go_out=. --plugin=protoc-gen-grpc="$GOBIN/protoc-gen-go-grpc" --grpc_out=. -I../seating/proto ../seating/proto/seating.proto

echo "Proto generation complete."
