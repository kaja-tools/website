# Fly terminates TLS at the edge and forwards plain HTTP to internal_port, so
# Caddy serves :8080 in the clear. Automatic HTTPS is off: there is no
# certificate for it to manage and an ACME attempt would only fail.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Astro fingerprints everything it emits under /_astro, so those URLs can
	# never change meaning. Everything else revalidates on each request; the
	# pages are a few kilobytes and deploys should be visible immediately.
	@hashed path /_astro/*
	@unhashed not path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "public, max-age=0, must-revalidate"

	# The Go server this replaced answered on /privacy, /privacy/ and
	# /privacy.html alike. Astro only emits the directory form, so send the
	# .html spelling there rather than 404 on links that already exist.
	redir /index.html / 301
	@legacy path_regexp legacy ^/(.+)\.html$
	redir @legacy /{re.legacy.1}/ 301

	# `astro build` writes each page as <name>/index.html, which file_server
	# serves for the extensionless URL. This is what replaces the old Go
	# server's hand-rolled extension guessing.
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
