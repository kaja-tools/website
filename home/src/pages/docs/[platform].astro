---
/* The docs: two columns — the sections, and the page. The screenshots are in
   the copy, under the paragraph each one is about. The page is the core flow
   and nothing else: install, connect an app, make the first call, write a
   script, reach for a helper, keep files, keep a secret, run a script from
   outside, point an agent at it. A concept is defined once, at the top of its
   section; the platform blocks under it hold only what differs between the
   desktop, which does everything in the window, and the container, which is
   set up from the files you mount. The section list lives in `data/docs.ts`,
   which the nav reads; an `id` here has to match one there.

   The voice is a person explaining Kaja to another developer: what a thing
   does first, then how to do it, in short sentences that name the button.
   Troubleshooting is `Trouble.astro` and sits in the section it belongs to,
   never collected at the foot — and only for a failure the app really
   produces, quoted in the app's own words.

   One file, two pages: `/docs/desktop/` and `/docs/docker/`. The URL is which
   build you are reading for, so a link carries it and the blocks that belong
   to the other build are never on the page. `/docs` redirects to Desktop.

   Keyboard shortcuts are the desktop's to spell in ⌘ symbols. The container is
   read in a browser on any OS, so its blocks name the control (Run, Files) and
   give a key only in the form the window itself draws off a Mac (Ctrl+⏎). */
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import DocsAside from "../../components/DocsAside.astro";
import DocsMotion from "../../components/DocsMotion.astro";
import Figure from "../../components/Figure.astro";
import Icon from "../../components/Icon.astro";
import Note from "../../components/Note.astro";
import Platform from "../../components/Platform.astro";
import PlatformToggle from "../../components/PlatformToggle.astro";
import Snippet from "../../components/Snippet.astro";
import Trouble from "../../components/Trouble.astro";
import * as snippets from "../../data/snippets";
import { builds, platformOf } from "../../data/docs";
import { declaration, saysFor, verbs } from "../../data/runtime";
import { shots } from "../../data/shots";

export function getStaticPaths() {
  return builds.map((build) => ({ params: { platform: build.id } }));
}

/* Read off the URL rather than out of `Astro.params`, so the page and the
   blocks inside it answer the question the same way. */
const build = builds.find((candidate) => candidate.id === platformOf(Astro.url))!;

const appStore = "https://apps.apple.com/us/app/kaja-for-grpc-and-twirp/id6761604205?mt=12";

const section = "scroll-mt-20 pt-16 first:pt-14";
const legend = "mb-2 font-display text-prose font-semibold tracking-[0.06em] text-muted-foreground uppercase";
const copy = "max-w-copy text-base/[1.7] text-pretty";
const muted = "max-w-copy text-base/[1.7] text-muted-foreground";
const code = "rounded-sm border border-border bg-card px-1.5 py-0.5 font-mono text-fine";
const key = "rounded-sm border border-border bg-card px-1.5 py-0.5 font-mono text-fine text-foreground";
const link = "text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground";
const term = "font-medium text-foreground";
/* The heading a troubleshooting block and the helper table are introduced by:
   smaller than a section's, and set in the copy rather than over it. */
const subhead = "mt-8 max-w-copy text-base font-medium text-foreground";

/* The two builds, one line each, under the intro — both of them on both
   pages, because the first thing the page owes a reader is which one they
   are on and that the other exists. */
const summaries = [
  { name: "Desktop", says: "Install Kaja and add your APIs from the sidebar." },
  { name: "Docker", says: "Put your APIs, variables and scripts in kaja.json, and run the container." },
];

/* The `docker run` above, argument by argument. */
const dockerArguments = [
  { flag: "--pull always", says: "Pull the latest image." },
  { flag: "--name kaja", says: "Name the container." },
  { flag: "-d", says: "Run in the background." },
  { flag: "-p 41520:41520", says: "Map the port. Kaja listens on 41520." },
  { flag: "-v .../proto:/workspace/proto", says: ".proto files for gRPC and Twirp apps." },
  { flag: "-v .../kaja.json:/workspace/kaja.json", says: "Apps and variables." },
  { flag: "-v .../scripts:/workspace/scripts", says: "Optional. .ts scripts, listed under Files." },
  { flag: "-e KAJA_TOKEN=...", says: "Optional. The value of the secret variable named token." },
  { flag: "--add-host=host.docker.internal:host-gateway", says: "Reach services on the host as host.docker.internal." },
];

/* The app types, and the parameters each one's block takes. Each wears the
   mark the app draws it with, so a type is recognised here and in the tree.
   This is the container's own list and stays the configuration reference it
   is: the sentences the desktop's dialog gets are in `forms`. */
const types = [
  { name: "grpc", parameters: ["url", "proto_dir", "reflection", "headers"] },
  { name: "twirp", parameters: ["url", "proto_dir", "headers"] },
  { name: "openapi", parameters: ["spec_url", "base_url", "headers"] },
  { name: "mcp", parameters: ["url", "headers"] },
] as const;

/* What the desktop's New app dialog asks for, type by type, in the order the
   dialog lists them. */
const forms = [
  { name: "grpc", label: "gRPC", asks: "Connect to a server using reflection or .proto files." },
  { name: "openapi", label: "OpenAPI", asks: "Add a spec from a URL, a file, or pasted text." },
  { name: "twirp", label: "Twirp", asks: "Connect to a server using its address and .proto files." },
] as const;

/* The three views a run has, which is what the editor's results are read in.
   One row each, in the order the segmented control lists them. */
const views = [
  { name: "Calls", says: "Every request and response." },
  { name: "Canvas", says: "Tables, text, questions and anything else the script drew." },
  { name: "Stats", says: "Latency and timing for the run." },
];

/* The desktop's variable sources, one row each. */
const desktopSources = [
  { form: "Value", says: "Stored directly in the workspace." },
  { form: "Keychain", says: "Stored in the macOS Keychain. Use this for tokens and other secrets." },
  { form: "Environment", says: "Read from an environment variable." },
];

/* Where a value in `variables` may live. `says` is split around the one
   thing in it that is itself code, which is what keeps the rows a list rather
   than hand-written ones. */
const sources = [
  { form: '"value"', says: ["A plain value, kept in the file."] },
  { form: '"${secret}"', says: ["A secret, read from ", "KAJA_NAME", " in the container's environment."] },
  { form: '"${env:X}"', says: ["The environment variable ", "X", "."] },
];

/* The three tools an agent gets, and what each one is for. */
const tools = [
  { name: "list_services", says: "One TypeScript signature per method, marked read or write." },
  { name: "describe_method", says: "The types a method uses, and an example call." },
  { name: "run_script", says: "Runs a script. Every request and response comes back in the result." },
];

/* The screenshots the page shows, each written into the section it belongs to
   and, where the two builds differ, into one platform's block. A crop is read
   at the width of the column now, so it can hold a whole dialog; one taller
   than it is wide is capped by `--size-figure` and stands beside the copy
   instead of filling it. A section with nothing worth showing has none, and a
   picture that says what it is has no caption. */
const figures = {
  app: {
    shot: shots.run,
  },
  newApp: {
    shot: shots.newApp,
    crop: { x: 0.302, y: 0.28, w: 0.396, h: 0.44 },
  },
  /* The tree belongs to the first call rather than to Apps: it is where you
     click, and both builds click in the same place. */
  tree: {
    shot: shots.apps,
    crop: { x: 0.0, y: 0.319, w: 0.208, h: 0.506 },
  },
  /* The call Kaja wrote for the method above it, in the draft it opened. */
  generated: {
    shot: shots.draft,
    crop: { x: 0.212, y: 0.062, w: 0.56, h: 0.125 },
    caption: "The call Kaja writes when you click ListMovies in the tree.",
  },
  run: {
    shot: shots.run,
    crop: { x: 0.209, y: 0.053, w: 0.7, h: 0.497 },
  },
  variables: {
    shot: shots.variables,
    crop: { x: 0.215, y: 0.062, w: 0.785, h: 0.338 },
  },
  agent: {
    shot: shots.agent,
    crop: { x: 0.222, y: 0.231, w: 0.75, h: 0.41 },
  },
};
---

<Layout title={build.title} description={build.description}>
  <div class="mx-auto grid w-full max-w-doc grid-cols-1 items-start gap-10 px-6 md:px-8 lg:max-w-docs lg:grid-cols-[13.5rem_minmax(0,1fr)] lg:gap-16">
    <DocsAside />

    <div class="min-w-0 max-w-docs-main py-10 pb-40">
      <p class="animate-rise text-xs font-semibold tracking-[0.09em] text-muted-foreground uppercase opacity-0">Documentation</p>
      <h1 class="mt-2.5 animate-rise font-display text-title font-bold tracking-display opacity-0" style={{ animationDelay: "0.06s" }}>Set up Kaja</h1>
      <p class="mt-3.5 max-w-copy animate-rise text-intro/[1.6] text-pretty text-muted-foreground opacity-0" style={{ animationDelay: "0.12s" }}>
        Install Kaja, connect an API, and run your first call.
      </p>
      <dl class="mt-5 flex max-w-copy animate-rise flex-col gap-2 opacity-0" style={{ animationDelay: "0.18s" }}>
        {
          summaries.map((summary) => (
            <div class="flex gap-3.5">
              <dt class="w-20 shrink-0 font-medium">{summary.name}</dt>
              <dd class="text-muted-foreground">{summary.says}</dd>
            </div>
          ))
        }
      </dl>

      {
        /* The sidebar holds the toggle at `lg` and up, and isn't there below
            it — so this is where the platform is picked on a phone. */
      }
      <div class="mt-6 max-w-64 lg:hidden">
        <PlatformToggle />
      </div>

      <section id="installation" data-docs-section class={section}>
        <h2 class={legend}>Installation</h2>

        <Platform only="desktop">
          <p class={copy}>Install Kaja from the Mac App Store.</p>
          <div class="mt-5">
            <Button href={appStore} target="_blank" rel="noopener">
              <Icon name="apple" />
              Mac App Store
            </Button>
          </div>
        </Platform>

        <Platform only="docker">
          <p class={copy}>
            Mount <code class={code}>kaja.json</code>, your protos and your scripts into <code class={code}>/workspace</code>. Kaja serves the UI on port{" "}
            <code class={code}>41520</code>.
          </p>
          <div class="mt-5">
            <Snippet file="shell" kind="shell" lang="shell" code={snippets.dockerRun} />
          </div>
          <p class:list={["mt-4", muted]}>
            Then open <a href="http://localhost:41520" class={link}>localhost:41520</a>.
          </p>
          <dl class="mt-5 flex flex-col gap-3">
            {
              dockerArguments.map((argument) => (
                <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                  <dt class="shrink-0 py-0.5 font-mono text-xs text-code-key sm:w-84">{argument.flag}</dt>
                  <dd class="text-prose/[1.6] text-muted-foreground">{argument.says}</dd>
                </div>
              ))
            }
          </dl>
          <div class="mt-5">
            <Note variant="watch" lead="The workspace is read-only.">Kaja never writes to the mounted files. Edit them on disk.</Note>
          </div>
        </Platform>

        <Figure {...figures.app} />
      </section>

      <section id="apps" data-docs-section class={section}>
        <h2 class={legend}>Apps</h2>
        <p class={copy}>An app is one API Kaja can call. Its services and methods appear in the sidebar under the app's name.</p>

        <Platform only="desktop">
          <p class:list={["mt-5", copy]}>
            Add an app with <span class={key}>+</span> beside Apps in the sidebar. Pick the type, then give Kaja the address and the authentication it needs.
          </p>
          <dl class="mt-5 grid grid-cols-[6rem_1fr] gap-px overflow-hidden rounded-frame border border-border bg-border">
            {
              forms.map((form) => (
                <>
                  <dt class="flex items-center gap-2 bg-card px-3.5 py-2.5 text-fine font-medium">
                    <Icon name={form.name} size={14} class="shrink-0 text-muted-foreground" />
                    {form.label}
                  </dt>
                  <dd class="bg-card px-3.5 py-2.5 text-fine/[1.6] text-muted-foreground">{form.asks}</dd>
                </>
              ))
            }
          </dl>
          <p class:list={["mt-5", muted]}>Kaja tests the connection before saving. Headers entered on the form are sent with every call.</p>

          <Figure {...figures.newApp} />

          <p class={subhead}>If the app won't connect</p>
          <div class="mt-4 flex max-w-copy flex-col gap-3">
            <Trouble symptom="“The server answered, but doesn't serve the reflection API.”">
              The gRPC server is reachable, but it does not register the reflection service. Click <strong class={term}>Use proto files</strong> in the banner and
              point Kaja at a folder of <code class={code}>.proto</code> files instead.
            </Trouble>
            <Trouble symptom="“Couldn't parse the document”, or “That URL returned a web page, not an OpenAPI document”">
              The URL is serving HTML, such as a documentation site or a sign-in redirect, or the file is not valid JSON or YAML. Open the URL in a browser and
              check that it returns the spec itself. If it needs a credential, switch the source to <strong class={term}>File</strong> or <strong class={term}
                >Paste</strong
              >
              and give Kaja the document directly.
            </Trouble>
          </div>
        </Platform>

        <Platform only="docker">
          <p class:list={["mt-5", copy]}>
            Define your apps in <code class={code}>kaja.json</code>. Each one has a name and a block naming its type.
          </p>
          <div class="mt-5">
            <Snippet file="kaja.json" kind="configuration" lang="json" code={snippets.apps} />
          </div>
          <p class:list={["mt-5", muted]}>Each type takes its own keys:</p>
          <dl class="mt-4 grid grid-cols-[7rem_1fr] gap-px overflow-hidden rounded-frame border border-border bg-border">
            {
              types.map((type) => (
                <>
                  <dt class="flex items-center gap-2 bg-card px-3.5 py-2.5 font-mono text-xs text-code-key">
                    <Icon name={type.name} size={14} class="shrink-0 text-muted-foreground" />
                    {type.name}
                  </dt>
                  <dd class="bg-card px-3.5 py-2.5 text-fine/[1.6] text-muted-foreground">
                    {type.parameters.map((parameter, i) => (
                      <>
                        {i > 0 && ", "}
                        <code class="text-foreground">{parameter}</code>
                      </>
                    ))}
                  </dd>
                </>
              ))
            }
          </dl>
          <p class:list={["mt-4", muted]}>
            <code class={code}>proto_dir</code> is relative to <code class={code}>/workspace</code>. A gRPC app with <code class={code}>reflection</code> needs no
            protos. <code class={code}>headers</code> are sent with every call. Services running on the host are reached as <code class={code}
              >host.docker.internal</code
            >.
          </p>
          <p class:list={["mt-4", muted]}>
            Scripts import an app by name: <code class={code}>import {"{ Teams }"} from "teams"</code>.
          </p>

          <p class={subhead}>If the app won't connect</p>
          <div class="mt-4 flex max-w-copy flex-col gap-3">
            <Trouble symptom="“Couldn't reach the server.”">
              Inside the container, <code class={code}>localhost</code> is the container itself. Point the app at <code class={code}>host.docker.internal</code> and
              start the container with <code class={code}>--add-host=host.docker.internal:host-gateway</code>.
            </Trouble>
            <Trouble symptom="“The server answered, but doesn't serve the reflection API.”">
              The gRPC server is reachable, but it does not register the reflection service. Drop <code class={code}>reflection</code> from the app and set{" "}
              <code class={code}>proto_dir</code> to a folder of <code class={code}>.proto</code> files under <code class={code}>/workspace</code>.
            </Trouble>
            <Trouble symptom="“Couldn't parse the document”, or “That URL returned a web page, not an OpenAPI document”">
              The <code class={code}>spec_url</code> is serving HTML, such as a documentation site or a sign-in redirect, or the file is not valid JSON or YAML. Fetch
              that URL yourself and check it returns the spec itself rather than a page about it.
            </Trouble>
          </div>
        </Platform>
      </section>

      <section id="first-call" data-docs-section class={section}>
        <h2 class={legend}>Run your first call</h2>
        <p class={copy}>Once an app is connected, four steps get you a response.</p>

        <p class:list={["mt-5", copy]}>
          <strong class={term}>1.</strong> Open an app in the sidebar and click one of its methods.
        </p>

        <Figure {...figures.tree} />

        <p class:list={["mt-5", copy]}>
          <strong class={term}>2.</strong> Kaja writes a typed call into a new draft and opens it in the editor. Every field of the request is written out, so you
          can see what the method takes before you change anything.
        </p>

        <Figure {...figures.generated} />

        <Platform only="desktop">
          <p class:list={["mt-5", copy]}>
            <strong class={term}>3.</strong> Press <span class={key}>⌘⏎</span>, or click <strong class={term}>Run</strong> at the top right.
          </p>
        </Platform>

        <Platform only="docker">
          <p class:list={["mt-5", copy]}>
            <strong class={term}>3.</strong> Click <strong class={term}>Run</strong> at the top right, or press <span class={key}>Ctrl+⏎</span> (<span
              class={key}>⌘⏎</span
            > on a Mac).
          </p>
        </Platform>

        <p class:list={["mt-5", copy]}>
          <strong class={term}>4.</strong> The run opens below the editor on <strong class={term}>Calls</strong>. Click the call to read the request Kaja sent
          and the response it got back.
        </p>
      </section>

      <section id="scripts" data-docs-section class={section}>
        <h2 class={legend}>Writing scripts</h2>

        <Platform only="desktop">
          <p class={copy}>
            Scripts let you call APIs with TypeScript. Click a method to create a typed call, or start with an empty script. Press <span class={key}>⌘⏎</span> to
            run it. Save the script when you want to use it again.
          </p>
        </Platform>

        <Platform only="docker">
          <p class={copy}>
            Scripts let you call APIs with TypeScript. Click a method to create a typed call, or start with an empty script. Click{" "}
            <strong class={term}>Run</strong> to run it.
          </p>
        </Platform>

        <div class="mt-5">
          <Snippet file="scripts/a-night-out.ts" kind="script" lang="ts" code={snippets.script} />
        </div>
        <p class:list={["mt-4", muted]}>
          A script is TypeScript with top-level <code class={code}>await</code> and one import for each app. Results appear below the editor:
        </p>
        <dl class="mt-4 flex max-w-copy flex-col gap-3">
          {
            views.map((view) => (
              <div class="flex gap-3.5">
                <dt class="w-20 shrink-0 py-0.5 text-fine font-medium">{view.name}</dt>
                <dd class="text-prose/[1.6] text-muted-foreground">{view.says}</dd>
              </div>
            ))
          }
        </dl>

        <Figure {...figures.run} />

        <p class:list={["mt-8", muted]}>
          Scripts also get <code class={code}>fetch</code> and <code class={code}>console</code>, both bound to the current run. A{" "}
          <code class={code}>fetch</code> request appears in Calls like any other call.
        </p>
        <p class:list={["mt-5", muted]}>
          Every generated method takes headers as its second argument. Call <code class={code}>.withHeaders()</code> when you also need the headers the API answered
          with.
        </p>

        <Platform only="desktop">
          <p class:list={["mt-5", muted]}>
            <span class={key}>⌘P</span> finds a method, file or draft by name.
          </p>
        </Platform>

        <Platform only="docker">
          <p class:list={["mt-5", muted]}>
            <span class={key}>Ctrl+P</span> (<span class={key}>⌘P</span> on a Mac) finds a method, file or draft by name.
          </p>
        </Platform>
      </section>

      <section id="helpers" data-docs-section class={section}>
        <h2 class={legend}>Kaja helpers</h2>
        <p class={copy}>
          A script can import <code class={code}>kaja</code> to draw on the run's canvas, ask you a question, or hold a call for approval. The table lists every helper.
          The entries under it have the detail.
        </p>

        <div class="mt-5 grid max-w-copy grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] gap-px overflow-hidden rounded-frame border border-border bg-border">
          <div class="bg-card px-3.5 py-2 text-fine font-medium text-muted-foreground">Helper</div>
          <div class="bg-card px-3.5 py-2 text-fine font-medium text-muted-foreground">Use it to</div>
          {
            verbs.map((verb) => (
              <>
                <div class="bg-card px-3.5 py-2.5 font-mono text-xs break-words text-code-key">
                  <a href={`#${verb.name.split(",")[0].trim()}`} class="hover:text-foreground">
                    {verb.name}
                  </a>
                </div>
                <div class="bg-card px-3.5 py-2.5 text-fine/[1.6] text-muted-foreground">{verb.use}</div>
              </>
            ))
          }
        </div>

        <div class="mt-10 flex flex-col gap-8">
          {
            verbs.map((verb) => (
              <div class="flex flex-col gap-3" id={verb.name.split(",")[0].trim()}>
                {/* The sentences are copy and wrap at `copy`; the snippet under them is
                      code and takes the whole column, like every other block on the page. */}
                <div class="flex max-w-copy flex-col gap-1 sm:flex-row sm:gap-3.5">
                  <span class="shrink-0 py-0.5 font-mono text-xs text-code-key sm:w-56">{verb.name}</span>
                  <span class="flex flex-col gap-2 text-prose/[1.6] text-muted-foreground">
                    {saysFor(verb, build.id).map((paragraph) => (
                      <span>{paragraph}</span>
                    ))}
                  </span>
                </div>
                {verb.code && <Snippet file={verb.file ?? "scripts/example.ts"} kind="script" lang="ts" code={verb.code} />}
                {/* Figure's own `mt-8` is for standing in prose; here it belongs to
                      the snippet above it, so the block's gap is the whole spacing. */}
                {verb.figure && (
                  <div class="[&>figure]:mt-0">
                    <Figure {...verb.figure} />
                  </div>
                )}
              </div>
            ))
          }
        </div>

        <p class:list={["mt-8", muted]}>
          The editor uses these declarations for autocomplete and inline documentation, and an agent reads the same ones when it writes a script. The whole of
          it is the{" "}
          <a href={declaration} class={link} target="_blank" rel="noopener">kaja module declaration</a>.
        </p>
      </section>

      <section id="files" data-docs-section class={section}>
        <h2 class={legend}>Files and drafts</h2>

        <Platform only="desktop">
          <p class={copy}>
            An unsaved script appears under <strong class={term}>Drafts</strong> in the sidebar. Choose <strong class={term}>Save as file</strong>, or press{
              " "
            }
            <span class={key}>⌘S</span>, to write it to disk under <strong class={term}>Files</strong>.
          </p>
          <p class:list={["mt-5", muted]}>
            <strong class={term}>Reveal in Finder</strong> opens the folder the file is in. Edit a file in another editor and Kaja picks up the change the next time
            you run it.
          </p>
        </Platform>

        <Platform only="docker">
          <p class={copy}>
            <strong class={term}>Files</strong> shows the <code class={code}>scripts</code> folder you mounted. Edit these files on disk; Kaja picks up the change
            the next time you run them.
          </p>
          <p class:list={["mt-5", muted]}>
            A script you write in the browser stays a <strong class={term}>draft</strong> in that browser. The container never writes to the mounted folder. To keep
            a script, add it to the <code class={code}>scripts</code> folder on disk yourself.
          </p>
        </Platform>
      </section>

      <section id="variables" data-docs-section class={section}>
        <h2 class={legend}>Variables</h2>

        <Platform only="desktop">
          <p class={copy}>
            Variables are named values shared by scripts and app configuration. Read one in a script with <code class={code}>kaja.variables.NAME</code>. Use{
              " "
            }
            <code class={code}>{"${NAME}"}</code> in app configuration, either by itself or inside a longer value.
          </p>
          <p class:list={["mt-5", muted]}>
            Add variables in the Variables section, <span class={key}>{"{ }"}</span> at the top of the sidebar. Each row has a source:
          </p>
          <dl class="mt-4 flex max-w-copy flex-col gap-3">
            {
              desktopSources.map((source) => (
                <div class="flex gap-3.5">
                  <dt class="w-24 shrink-0 py-0.5 text-fine font-medium">{source.form}</dt>
                  <dd class="text-prose/[1.6] text-muted-foreground">{source.says}</dd>
                </div>
              ))
            }
          </dl>

          <Figure {...figures.variables} />
        </Platform>

        <Platform only="docker">
          <p class={copy}>
            Variables are named values shared by scripts and app configuration. Read one in a script with <code class={code}>kaja.variables.NAME</code>. Use{
              " "
            }
            <code class={code}>{"${NAME}"}</code> in app configuration, either by itself or inside a longer value.
          </p>
          <p class:list={["mt-5", muted]}>
            Define variables in <code class={code}>kaja.json</code>.
          </p>
          <div class="mt-4">
            <Snippet file="kaja.json" kind="configuration" lang="json" code={snippets.variables} />
          </div>
          <dl class="mt-5 flex max-w-copy flex-col gap-3">
            {
              sources.map((source) => (
                <div class="flex gap-3.5">
                  <dt class="w-24 shrink-0 py-0.5 font-mono text-xs text-code-string" set:text={source.form} />
                  <dd class="text-prose/[1.6] text-muted-foreground">
                    {source.says.map((part, i) => (i % 2 ? <code class="text-foreground">{part}</code> : part))}
                  </dd>
                </div>
              ))
            }
          </dl>
          <div class="mt-5">
            <Note variant="watch" lead="Secrets never reach the browser.">
              <code class="text-foreground">{"${secret}"}</code> is resolved inside the container. Scripts get the placeholder, not the value.
            </Note>
          </div>

          <p class={subhead}>If a variable doesn't resolve</p>
          <div class="mt-4 flex max-w-copy flex-col gap-3">
            <Trouble symptom="The Variables tab shows “KAJA_TOKEN not set”, and calls go out with ${token} unexpanded.">
              A <code class={code}>{"${secret}"}</code> variable reads <code class={code}>KAJA_NAME</code> from the container's environment, and nothing set it. Pass
              it on the <code class={code}>docker run</code> line as <code class={code}>-e KAJA_TOKEN=...</code> and start the container again.
            </Trouble>
          </div>
        </Platform>
      </section>

      <section id="deeplinks" data-docs-section class={section}>
        <h2 class={legend}>Deeplinks</h2>
        <Platform only="desktop">
          <p class={copy}>
            Saved scripts have deeplinks. Right-click the file, or open the menu beside Run, and choose <strong class={term}>Copy deeplink…</strong> (<span
              class={key}>⌘⇧C</span
            >).
          </p>
        </Platform>

        <Platform only="docker">
          <p class={copy}>
            Saved scripts have deeplinks. Right-click the file, or open the menu beside Run, and choose <strong class={term}>Copy deeplink…</strong>.
          </p>
        </Platform>
        <div class="mt-5">
          <Platform only="desktop">
            <Snippet file="deeplink" kind="shell" lang="shell" code={snippets.deeplinkDesktop} />
            <p class:list={["mt-4", muted]}>
              Open it with <code class={code}>open</code>, a Raycast quicklink or a Shortcut.
            </p>
            <p class:list={["mt-4", muted]}>
              The deeplink opens the script and fills in its input values. Press <span class={key}>⏎</span> to run it.
            </p>
          </Platform>
          <Platform only="docker">
            <Snippet file="deeplink" kind="shell" lang="shell" code={snippets.deeplinkDocker} />
            <p class:list={["mt-4", muted]}>
              The link opens the script and fills in its input values. Click <strong class={term}>Run</strong> to run it.
            </p>
          </Platform>
        </div>
        <p class:list={["mt-5", muted]}>
          Read the query parameters through <code class={code}>kaja.input</code>. Every value arrives as a string. A script run from the editor with nothing to
          carry gets an empty input:
        </p>
        <div class="mt-4">
          <Snippet file="scripts/whats-on.ts" kind="script" lang="ts" code={snippets.deeplinkScript} />
        </div>
        <Platform only="desktop">
          <p class:list={["mt-4", muted]}>
            <strong class={term}>Run with parameters…</strong> (<span class={key}>⇧⌘⏎</span>) asks for the keys the script reads, then runs it.
          </p>
        </Platform>

        <Platform only="docker">
          <p class:list={["mt-4", muted]}>
            <strong class={term}>Run with parameters…</strong>, in the menu beside Run, asks for the keys the script reads and then runs it.
          </p>
        </Platform>
      </section>

      <section id="agents" data-docs-section class={section}>
        <h2 class={legend}>Agents</h2>
        <p class={copy}>
          Kaja provides an <a href="https://modelcontextprotocol.io" class={link} target="_blank" rel="noopener">MCP</a> server for your connected APIs. An agent
          can inspect the available methods, write TypeScript scripts, and run them through Kaja.
        </p>
        <p class:list={["mt-5", muted]}>
          Open the plug menu at the top of the sidebar and turn on the MCP server. Copy the command or configuration shown for your agent.
        </p>

        <Platform only="desktop">
          <p class:list={["mt-5", muted]}>
            The server listens on <code class={code}>127.0.0.1:41521</code>.
          </p>

          <Figure {...figures.agent} />
        </Platform>

        <Platform only="docker">
          <p class:list={["mt-5", muted]}>
            The endpoint is Kaja's address plus <code class={code}>/mcp</code>. The token belongs to this browser. Scripts run in this tab, so keep it open
            while the agent works.
          </p>
        </Platform>

        <dl class="mt-5 flex max-w-copy flex-col gap-3">
          {
            tools.map((tool) => (
              <div class="flex gap-3.5">
                <dt class="w-32 shrink-0 py-0.5 font-mono text-xs text-code-key" set:text={tool.name} />
                <dd class="text-prose/[1.6] text-muted-foreground">{tool.says}</dd>
              </div>
            ))
          }
        </dl>
        <p class:list={["mt-5", muted]}>
          Scripts an agent creates appear as drafts under the agent's name. Its requests appear in Calls. A call wrapped in{" "}
          <code class={code}>kaja.approve</code> waits until you approve it.
        </p>

        <Platform only="docker">
          <p class={subhead}>If the agent loses the connection</p>
          <div class="mt-4 flex max-w-copy flex-col gap-3">
            <Trouble symptom="The agent's tool call fails with “no Kaja window is attached to this agent session”.">
              A script runs in the Kaja tab, not in the container, and that tab was closed or reloaded. Open <a href="http://localhost:41520" class={link}
                >localhost:41520</a
              > again and leave it open while the agent works.
            </Trouble>
          </div>
        </Platform>
      </section>
    </div>
  </div>

  <DocsMotion />
</Layout>
