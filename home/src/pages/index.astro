---
/* The home page, in the order a visitor needs it: what Kaja is, the one flow
   through it, what an agent does inside it and what it leaves behind, and the
   way in again at the end.

   It is read at two levels, and a section's `level` is which one it is on.
   The product story is the hero, the flow, the agent and the record, and it
   is set at full size. What makes Kaja different from another client — using
   it by hand, scripts rather than collections, the protocols and the agent —
   is a size down. The page gets quieter as it goes, so a visitor who reads to
   the end has met one story and not a catalogue. */
import Layout from "../layouts/Layout.astro";
import AgentTask from "../components/AgentTask.astro";
import Button from "../components/Button.astro";
import Canvas from "../components/Canvas.astro";
import Flow from "../components/Flow.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import { modes, promises, protocols } from "../data/home";

const frame = "mx-auto w-full max-w-page px-6 md:px-8";

const appStore = "https://apps.apple.com/us/app/kaja-for-grpc-and-twirp/id6761604205?mt=12";
const demo = "https://demo.kaja.tools/";

const tagline =
  "Connect gRPC, OpenAPI, or MCP. Explore APIs yourself, or let an agent write and run typed scripts. Every request stays visible and inspectable.";

const rule = "border-t border-border pt-4";
/* Two sizes, because the page's levels reach inside a section too: the record's
   three lines are the argument that section is making, and the two ways of
   working are the detail under a heading that is already a size down. */
const subhead = "font-display text-pane font-semibold tracking-display";
const label = "font-display text-lg font-semibold tracking-display";
---

<Layout title="Kaja - The API client for you and your agents" description={tagline}>
  <section class="pt-14 md:pt-16">
    <div class:list={[frame, "text-center"]}>
      <h1
        class="mx-auto mb-5 max-w-headline animate-rise font-display text-4xl/[1.05] font-bold tracking-hero text-balance opacity-0 md:text-hero"
        style={{ animationDelay: "0.12s" }}
      >
        The API client built for you and your agents.
      </h1>
      <p
        class="mx-auto mb-8 max-w-tagline animate-rise text-intro/[1.55] text-pretty text-muted-foreground opacity-0 md:text-lede"
        style={{ animationDelay: "0.2s" }}
      >
        {tagline}
      </p>
      {
        /* The demo is the way in: it is the primary button and the app store
          is the alternative, because nothing has to be installed to see the
          thing work. */
      }
      <div class="flex animate-rise flex-wrap items-center justify-center gap-3 opacity-0" style={{ animationDelay: "0.28s" }}>
        <Button href={demo} size="lg">Try Kaja &rarr;</Button>
        <Button href={appStore} variant="outline" size="lg" target="_blank" rel="noopener">
          <Icon name="apple" />
          Download for Mac
        </Button>
      </div>
      <p class="mt-4 animate-rise text-fine text-muted-foreground opacity-0" style={{ animationDelay: "0.34s" }}>No setup. Opens a demo API.</p>
    </div>

    <div class="mt-10 md:mt-12"><Canvas /></div>

    {
      /* The app itself, once and whole, under the drawing of what it does.
         Every close-up further down the page is a region of one of the shots,
         and several of them are regions of this one. */
    }
    <div class:list={[frame, "mt-16"]}>
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-hero">
        <img src="/assets/app-hero.png" width="2880" height="1800" alt="Kaja running a script against gRPC, OpenAPI and MCP apps" class="block h-auto w-full" />
      </div>
    </div>
  </section>

  <Section title="Connect. Run. Inspect." lead="One window: your APIs on the left, the script in the middle, and every call it made underneath.">
    <Flow />
  </Section>

  <Section
    title="Agents can do the work without becoming a black box."
    lead="Let an agent write and run TypeScript against your APIs. Every request it makes appears alongside your own."
  >
    <AgentTask />
  </Section>

  <Section
    title="Every call is on the record."
    lead="Whether a request came from you, a script, or an agent, Kaja keeps the request, response, headers, status, duration, and size available for inspection."
  >
    <div class="mt-10 grid gap-6 sm:grid-cols-3 md:mt-12">
      {promises.map((line) => <p class:list={[rule, subhead]}>{line}</p>)}
    </div>
  </Section>

  <Section
    title="Use it yourself, too."
    level="support"
    lead="Browse methods, fill in parameters, send requests and inspect responses, just like a traditional API client. Your requests and your agent's requests live in the same history."
  />

  <Section
    title="Built around scripts, not collections."
    level="support"
    lead="Need one request? Send it directly. Need a workflow? Write a typed script, or let your agent write it. Both produce the same inspectable history."
  >
    <div class="mt-8 grid gap-8 md:mt-10 md:grid-cols-2 md:gap-12">
      {
        modes.map((mode) => (
          <div class={rule}>
            <h3 class={label}>{mode.name}</h3>
            <p class="mt-1.5 text-prose/[1.6] text-pretty text-muted-foreground">{mode.says}</p>
          </div>
        ))
      }
    </div>
  </Section>

  {
    /* Named for what a visitor brings rather than for what Kaja counts, so
       the heading survives an agent being added to the list. */
  }
  <Section
    title="Your APIs. Your agent."
    level="support"
    lead="Connect through gRPC, OpenAPI, MCP or Twirp, then use Kaja with the coding agent you already work with."
  >
    <div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 md:mt-10 lg:grid-cols-4">
      {
        protocols.map((protocol) => (
          <div class={rule}>
            <p class:list={["flex items-center gap-2", label]}>
              <Icon name={protocol.mark} />
              {protocol.name}
            </p>
            <p class="mt-1.5 text-prose/[1.6] text-pretty text-muted-foreground">{protocol.from}</p>
          </div>
        ))
      }
    </div>
  </Section>

  {
    /* The way out is the way in: the same ask as the hero, in the same order,
       and no new claim at the foot of the page. */
  }
  <section class:list={[frame, "pt-24 pb-24 text-center md:pt-36 md:pb-32"]}>
    <h2 class="mx-auto max-w-headline font-display text-3xl/[1.1] font-bold tracking-display text-balance md:text-cta">Try Kaja.</h2>
    <p class="mx-auto mt-4 max-w-tagline text-intro/[1.6] text-pretty text-muted-foreground">Explore an API in the live demo. No setup required.</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={demo} size="lg">Try Kaja &rarr;</Button>
      <Button href={appStore} variant="outline" size="lg" target="_blank" rel="noopener">
        <Icon name="apple" />
        Download for Mac
      </Button>
    </div>
  </section>
</Layout>
