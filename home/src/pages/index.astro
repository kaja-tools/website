---
/* The home page: what Kaja is, the one flow through it, what an agent does
   inside it, and the way in again at the end. Four things, and the agent is
   the last of them — everything that used to follow was the same claims a
   second time, so the page stops where its argument does. */
import Layout from "../layouts/Layout.astro";
import AgentTask from "../components/AgentTask.astro";
import Button from "../components/Button.astro";
import Canvas from "../components/Canvas.astro";
import Flow from "../components/Flow.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";

const frame = "mx-auto w-full max-w-page px-6 md:px-8";

const appStore = "https://apps.apple.com/us/app/kaja-for-grpc-and-twirp/id6761604205?mt=12";
const demo = "https://demo.kaja.tools/";

const tagline =
  "Connect gRPC, OpenAPI, or MCP. Explore APIs yourself, or let an agent write and run typed scripts. Every request stays visible and inspectable.";
---

<Layout title="Kaja - The API client for you and your agents" description={tagline}>
  <section class="pt-14 md:pt-16">
    <div class:list={[frame, "text-center"]}>
      <h1
        class="mx-auto mb-5 max-w-headline animate-rise font-display text-4xl/[1.05] font-bold tracking-hero text-balance opacity-0 md:text-hero"
        style={{ animationDelay: "0.12s" }}
      >
        The API client built for you and your agents.
      </h1>
      <p
        class="mx-auto mb-8 max-w-tagline animate-rise text-intro/[1.55] text-pretty text-muted-foreground opacity-0 md:text-lede"
        style={{ animationDelay: "0.2s" }}
      >
        {tagline}
      </p>
      {
        /* The demo is the way in: it is the primary button and the app store
          is the alternative, because nothing has to be installed to see the
          thing work. */
      }
      <div class="flex animate-rise flex-wrap items-center justify-center gap-3 opacity-0" style={{ animationDelay: "0.28s" }}>
        <Button href={demo} size="lg">Try Kaja &rarr;</Button>
        <Button href={appStore} variant="outline" size="lg" target="_blank" rel="noopener">
          <Icon name="apple" />
          Download on the Mac App Store
        </Button>
      </div>
      <p class="mt-4 animate-rise text-fine text-muted-foreground opacity-0" style={{ animationDelay: "0.34s" }}>No setup. Opens a demo API.</p>
    </div>

    <div class="mt-10 md:mt-12"><Canvas /></div>

    {
      /* The app itself, once and whole, under the drawing of what it does.
         Every close-up further down the page is a region of one of the shots,
         and several of them are regions of this one. */
    }
    <div class:list={[frame, "mt-16"]}>
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-hero">
        <img src="/assets/app-hero.png" width="2880" height="1800" alt="Kaja running a script against gRPC, OpenAPI and MCP apps" class="block h-auto w-full" />
      </div>
    </div>
  </section>

  <Section title="Connect. Run. Inspect." lead="One window: your APIs on the left, the script in the middle, and every call it made underneath.">
    <Flow />
  </Section>

  <Section
    title="Agents can do the work without becoming a black box."
    lead="Let an agent write and run TypeScript against your APIs. Every request it makes appears alongside your own."
  >
    <AgentTask />
  </Section>

  {
    /* The way out is the way in: the same ask as the hero, in the same order,
       and no new claim at the foot of the page. */
  }
  <section class:list={[frame, "pt-24 pb-24 text-center md:pt-36 md:pb-32"]}>
    <h2 class="mx-auto max-w-headline font-display text-3xl/[1.1] font-bold tracking-display text-balance md:text-cta">Try Kaja.</h2>
    <p class="mx-auto mt-4 max-w-tagline text-intro/[1.6] text-pretty text-muted-foreground">Explore an API in the live demo. No setup required.</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={demo} size="lg">Try Kaja &rarr;</Button>
      <Button href={appStore} variant="outline" size="lg" target="_blank" rel="noopener">
        <Icon name="apple" />
        Download on the Mac App Store
      </Button>
    </div>
  </section>
</Layout>
