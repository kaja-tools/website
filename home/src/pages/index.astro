---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import Feature from "../components/Feature.astro";
import Icon from "../components/Icon.astro";
import Slideshow from "../components/Slideshow.astro";

const shots = [
  { src: "/assets/screenshot-1.png", width: 2272, height: 1824 },
  { src: "/assets/screenshot-2.png", width: 2184, height: 1736 },
  { src: "/assets/screenshot-3.png", width: 2272, height: 1824 },
  { src: "/assets/screenshot-4.png", width: 2272, height: 1824 },
  { src: "/assets/screenshot-5.png", width: 2432, height: 1946 },
];

const section = "mx-auto w-full max-w-page px-6 md:px-8";
---

<Layout title="Kaja - Code-based UI for gRPC and Twirp APIs" description="Kaja is a code-based UI for exploring and calling gRPC and Twirp APIs.">
  <section class:list={[section, "pt-16 md:pt-20"]}>
    <p class="mb-4.5 text-xs font-semibold tracking-[0.08em] text-muted-foreground uppercase">macOS · Docker · MIT</p>
    <h1 class="mb-5 max-w-headline text-4xl/[1.1] font-semibold tracking-tight md:text-hero">Explore and call your APIs with code</h1>
    <p class="mb-8 max-w-tagline text-lg/[1.6] text-muted-foreground">Kaja is a code-based UI for exploring and calling gRPC and Twirp APIs.</p>
    <div class="flex flex-wrap items-center gap-3">
      <Button href="https://apps.apple.com/us/app/kaja-for-grpc-and-twirp/id6761604205?mt=12" size="lg" target="_blank" rel="noopener">
        <Icon name="apple" />
        Mac App Store
      </Button>
      <Button href="https://demo.kaja.tools/" variant="outline" size="lg">Try live demo</Button>
    </div>
  </section>

  <section class:list={[section, "pt-12"]}>
    <Slideshow slides={shots} label="seating.Seating — GetSeatMap" />
  </section>

  <section class:list={[section, "grid gap-4 pt-16 pb-20 md:grid-cols-3 md:pt-20 md:pb-24"]}>
    <Feature title="Code-based UI" icon="code">Write code to explore and call your APIs with full autocomplete support.</Feature>
    <Feature title="gRPC & Twirp" icon="server">Native support for both gRPC and Twirp protocols out of the box.</Feature>
    <Feature title="macOS & Docker" icon="package">Install from the Mac App Store in one click, or run as a Docker container anywhere.</Feature>
  </section>
</Layout>
