---
import Layout from "../layouts/Layout.astro";
import Feature from "../components/Feature.astro";
import Slideshow from "../components/Slideshow.astro";

const slides = [1, 2, 3, 4, 5].map((n) => ({
  src: `/assets/screenshot-${n}.png`,
  alt: "Kaja application screenshot",
}));

const btn = "inline-flex w-full max-w-[280px] items-center justify-center rounded-btn font-semibold transition-all duration-200 md:w-auto md:max-w-none";
---

<Layout title="Kaja - Code-based UI for gRPC and Twirp APIs" description="Kaja is a code-based UI for exploring and calling gRPC and Twirp APIs.">
  <section class="animate-fade-in py-8 text-center md:pt-10 md:pb-6">
    <h1 class="text-gradient mb-4 text-[clamp(2rem,5vw,3.5rem)] font-bold">Explore and call your APIs with code</h1>
    <p class="mx-auto mb-6 max-w-tagline text-[1.1rem] text-muted md:text-xl/[1.6]">Kaja is a code-based UI for exploring and calling gRPC and Twirp APIs.</p>
    {/* Stacked and centred on mobile; above md the default `stretch` is what makes the shorter button match the App Store one. */}
    <div class="flex flex-col flex-wrap items-center justify-center gap-4 md:flex-row md:items-stretch">
      <a
        href="https://apps.apple.com/us/app/kaja-for-grpc-and-twirp/id6761604205?mt=12"
        class={`${btn} gradient-ring gap-3 border border-white/25 bg-black px-5 py-2.5 shadow-store hover:border-transparent hover:shadow-store-hover`}
        target="_blank"
        rel="noopener"
      >
        <svg class="size-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
          ></path>
        </svg>
        <span class="flex flex-col items-start text-left leading-[1.1]">
          <span class="text-[0.7rem] font-normal tracking-[0.02em] uppercase opacity-[0.85]">Download on the</span>
          <span class="text-xl/[1.1] font-semibold tracking-[0.01em]">Mac App Store</span>
        </span>
      </a>
      <a href="https://demo.kaja.tools/" class={`${btn} gap-2 border border-white/20 px-7 py-3.5 hover:border-white/30 hover:bg-white/5`}> Try Live Demo </a>
    </div>
  </section>

  <Slideshow slides={slides} />

  <section class="animate-fade-in grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-8 pt-8 pb-12 [animation-delay:0.2s] md:pt-12 md:pb-20">
    <Feature title="Code-based UI">
      <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"></path></svg>
      Write code to explore and call your APIs with full autocomplete support.
    </Feature>
    <Feature title="gRPC & Twirp">
      <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 6v6l4 2"></path>
      </svg>
      Native support for both gRPC and Twirp protocols out of the box.
    </Feature>
    <Feature title="macOS & Docker">
      <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
        <path d="M8 21h8M12 17v4"></path>
      </svg>
      Install from the Mac App Store in one click, or run as a Docker container anywhere.
    </Feature>
  </section>
</Layout>
