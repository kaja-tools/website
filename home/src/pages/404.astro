---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found - Kaja" description="This page does not exist.">
  <section class="animate-fade-in mx-auto max-w-doc py-20 text-center">
    <h1 class="text-gradient mb-4 text-[clamp(2rem,5vw,3rem)] font-bold">Page not found</h1>
    <p class="text-base/[1.6] text-muted">
      That page isn't here. Try the <a href="/" class="text-accent hover:underline">home page</a>.
    </p>
  </section>
</Layout>
