---
/* The docs: two columns — the sections, and the page. The screenshots are in
   the copy, under the paragraph each one is about. The page is the core flow
   and nothing else: install, connect an app, run a script, keep a secret, run
   a script from outside, point an agent at it. A concept is defined once, at
   the top of its section; the platform blocks under it hold only what differs
   between the desktop, which does everything in the window, and the container,
   which is set up from the files you mount. The copy is terse on purpose: what
   it is, how to use it, the code, stop. The section list lives in
   `data/docs.ts`, which the nav reads; an `id` here has to match one there. */
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import DocsAside from "../components/DocsAside.astro";
import DocsMotion from "../components/DocsMotion.astro";
import Figure from "../components/Figure.astro";
import Icon from "../components/Icon.astro";
import Note from "../components/Note.astro";
import Platform from "../components/Platform.astro";
import PlatformToggle from "../components/PlatformToggle.astro";
import Snippet from "../components/Snippet.astro";
import * as snippets from "../data/snippets";
import { declaration, verbs } from "../data/runtime";
import { shots } from "../data/shots";

const appStore = "https://apps.apple.com/us/app/kaja-for-grpc-and-twirp/id6761604205?mt=12";

const section = "scroll-mt-20 pt-16 first:pt-14";
const legend = "mb-2 font-display text-prose font-semibold tracking-[0.06em] text-muted-foreground uppercase";
const copy = "max-w-copy text-base/[1.7] text-pretty";
const muted = "max-w-copy text-base/[1.7] text-muted-foreground";
const code = "rounded-sm border border-border bg-card px-1.5 py-0.5 font-mono text-fine";
const key = "rounded-sm border border-border bg-card px-1.5 py-0.5 font-mono text-fine text-foreground";
const link = "text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground";
const term = "font-medium text-foreground";

/* The two builds, one line each, under the intro. */
const builds = [
  { name: "Desktop", says: "Install Kaja and add your APIs from the sidebar." },
  { name: "Docker", says: "Put your APIs, variables, and scripts in kaja.json and run the container." },
];

/* The `docker run` above, argument by argument. */
const dockerArguments = [
  { flag: "--pull always", says: "Pull the latest image." },
  { flag: "--name kaja", says: "Name the container." },
  { flag: "-d", says: "Run in the background." },
  { flag: "-p 41520:41520", says: "Map the port. Kaja listens on 41520." },
  { flag: "-v .../proto:/workspace/proto", says: ".proto files for gRPC and Twirp apps." },
  { flag: "-v .../kaja.json:/workspace/kaja.json", says: "Apps and variables." },
  { flag: "-v .../scripts:/workspace/scripts", says: "Optional. .ts scripts, listed under Files." },
  { flag: "-e KAJA_TOKEN=...", says: "Optional. The value of the secret variable named token." },
  { flag: "--add-host=host.docker.internal:host-gateway", says: "Reach services on the host as host.docker.internal." },
];

/* The app types, and the parameters each one's block takes. Each wears the
   mark the app draws it with, so a type is recognised here and in the tree. */
const types = [
  { name: "grpc", parameters: ["url", "proto_dir", "reflection", "headers"] },
  { name: "twirp", parameters: ["url", "proto_dir", "headers"] },
  { name: "openapi", parameters: ["spec_url", "base_url", "headers"] },
  { name: "mcp", parameters: ["url", "headers"] },
] as const;

/* What the desktop's New app dialog asks for, type by type, in the order the
   dialog lists them. */
const forms = [
  { name: "grpc", label: "gRPC", asks: "Server address. Reflection, or a folder of .proto files." },
  { name: "openapi", label: "OpenAPI", asks: "Spec URL, file, or pasted text." },
  { name: "twirp", label: "Twirp", asks: "Server address and a folder of .proto files." },
] as const;

/* The desktop's variable sources, one row each. */
const desktopSources = [
  { form: "Value", says: "Typed in." },
  { form: "Keychain", says: "Stored by macOS. Use it for tokens." },
  { form: "Environment", says: "Read from an environment variable." },
];

/* Where a value in `variables` may live. `says` is split around the one
   thing in it that is itself code, which is what keeps the rows a list rather
   than hand-written ones. */
const sources = [
  { form: '"value"', says: ["A plain value, kept in the file."] },
  { form: '"${secret}"', says: ["A secret, read from ", "KAJA_NAME", " in the container's environment."] },
  { form: '"${env:X}"', says: ["The environment variable ", "X", "."] },
];

/* The three tools an agent gets, and what each one is for. */
const tools = [
  { name: "list_services", says: "One TypeScript signature per method, marked read or write." },
  { name: "describe_method", says: "The types a method uses, and an example call." },
  { name: "run_script", says: "Runs a script. Every request and response comes back in the result." },
];

/* The screenshots the page shows, each written into the section it belongs to
   and, where the two builds differ, into one platform's block. A crop is read
   at the width of the column now, so it can hold a whole dialog; one taller
   than it is wide is capped by `--size-figure` and stands beside the copy
   instead of filling it. A section with nothing worth showing has none, and a
   picture that says what it is has no caption. */
const figures = {
  app: {
    shot: shots.run,
  },
  newApp: {
    shot: shots.newApp,
    crop: { x: 0.302, y: 0.28, w: 0.396, h: 0.44 },
  },
  tree: {
    shot: shots.apps,
    crop: { x: 0.0, y: 0.319, w: 0.208, h: 0.506 },
  },
  run: {
    shot: shots.run,
    crop: { x: 0.209, y: 0.05, w: 0.7, h: 0.5 },
  },
  variables: {
    shot: shots.variables,
    crop: { x: 0.215, y: 0.062, w: 0.785, h: 0.338 },
  },
  agent: {
    shot: shots.agent,
    crop: { x: 0.222, y: 0.231, w: 0.75, h: 0.41 },
  },
};

const description =
  "Set up Kaja on macOS or in Docker: connect gRPC, OpenAPI, Twirp and MCP apps, run scripts against them, keep secrets out of the file, and point an agent at it over MCP.";
---

<Layout title="Docs - Kaja" description={description}>
  {
    /* Desktop is what the page opens on; the boot script swaps it for whatever
      was picked last, before anything below is painted. */
  }
  <div data-docs-platform="desktop">
    <script is:inline>
      try {
        /* The URL is the address of what you are reading, so a link that names
           a platform beats whatever this browser picked last. Anything but
           `docker` leaves the page on the Desktop it is rendered with, which
           is also what a mistyped value gets. */
        const asked = new URLSearchParams(location.search).get("platform");
        const picked = asked ?? localStorage.getItem("kaja-docs-platform");
        if (picked === "docker") document.currentScript.parentElement.dataset.docsPlatform = picked;
      } catch {}
    </script>

    <div class="mx-auto grid w-full max-w-doc grid-cols-1 items-start gap-10 px-6 md:px-8 lg:max-w-docs lg:grid-cols-[12.25rem_minmax(0,1fr)] lg:gap-16">
      <DocsAside />

      <div class="min-w-0 max-w-docs-main py-10 pb-40">
        <p class="animate-rise text-xs font-semibold tracking-[0.09em] text-muted-foreground uppercase opacity-0">Documentation</p>
        <h1 class="mt-2.5 animate-rise font-display text-title font-bold tracking-display opacity-0" style={{ animationDelay: "0.06s" }}>Set up Kaja</h1>
        <p class="mt-3.5 max-w-copy animate-rise text-intro/[1.6] text-pretty text-muted-foreground opacity-0" style={{ animationDelay: "0.12s" }}>
          Install Kaja, connect an API, press Run.
        </p>
        <dl class="mt-5 flex max-w-copy animate-rise flex-col gap-2 opacity-0" style={{ animationDelay: "0.18s" }}>
          {
            builds.map((build) => (
              <div class="flex gap-3.5">
                <dt class="w-20 shrink-0 font-medium">{build.name}</dt>
                <dd class="text-muted-foreground">{build.says}</dd>
              </div>
            ))
          }
        </dl>

        {
          /* The sidebar holds the toggle at `lg` and up, and isn't there below
            it — so this is where the platform is picked on a phone. */
        }
        <div class="mt-6 max-w-64 lg:hidden">
          <PlatformToggle />
        </div>

        <section id="installation" data-docs-section class={section}>
          <h2 class={legend}>Installation</h2>

          <Platform only="desktop">
            <p class={copy}>Install from the Mac App Store.</p>
            <div class="mt-5">
              <Button href={appStore} target="_blank" rel="noopener">
                <Icon name="apple" />
                Mac App Store
              </Button>
            </div>
          </Platform>

          <Platform only="docker">
            <p class={copy}>
              Mount <code class={code}>kaja.json</code>, your protos and your scripts into <code class={code}>/workspace</code>. Kaja serves the UI on port
              41520.
            </p>
            <div class="mt-5">
              <Snippet file="shell" kind="shell" lang="shell" code={snippets.dockerRun} />
            </div>
            <p class:list={["mt-4", muted]}>
              Open <a href="http://localhost:41520" class={link}>localhost:41520</a>.
            </p>
            <dl class="mt-5 flex flex-col gap-3">
              {
                dockerArguments.map((argument) => (
                  <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                    <dt class="shrink-0 py-0.5 font-mono text-xs text-code-key sm:w-84">{argument.flag}</dt>
                    <dd class="text-prose/[1.6] text-muted-foreground">{argument.says}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="mt-5">
              <Note variant="watch" lead="The workspace is read-only.">Kaja never writes to the mounted files. Edit them on disk.</Note>
            </div>
          </Platform>

          <Figure {...figures.app} />
        </section>

        <section id="apps" data-docs-section class={section}>
          <h2 class={legend}>Apps</h2>
          <p class={copy}>An app is one API Kaja can call.</p>

          <Platform only="desktop">
            <p class:list={["mt-5", copy]}>Add an app from the sidebar. Enter its address and authentication.</p>
            <dl class="mt-5 grid grid-cols-[6rem_1fr] gap-px overflow-hidden rounded-frame border border-border bg-border">
              {
                forms.map((form) => (
                  <>
                    <dt class="flex items-center gap-2 bg-card px-3.5 py-2.5 text-fine font-medium">
                      <Icon name={form.name} size={14} class="shrink-0 text-muted-foreground" />
                      {form.label}
                    </dt>
                    <dd class="bg-card px-3.5 py-2.5 text-fine/[1.6] text-muted-foreground">{form.asks}</dd>
                  </>
                ))
              }
            </dl>
            <p class:list={["mt-5", muted]}>Kaja tests the connection before saving. Headers entered on the form are sent with every call.</p>

            <Figure {...figures.newApp} />
          </Platform>

          <Platform only="docker">
            <div class="mt-5">
              <Snippet file="kaja.json" kind="configuration" lang="json" code={snippets.apps} />
            </div>
            <dl class="mt-5 grid grid-cols-[7rem_1fr] gap-px overflow-hidden rounded-frame border border-border bg-border">
              {
                types.map((type) => (
                  <>
                    <dt class="flex items-center gap-2 bg-card px-3.5 py-2.5 font-mono text-xs text-code-key">
                      <Icon name={type.name} size={14} class="shrink-0 text-muted-foreground" />
                      {type.name}
                    </dt>
                    <dd class="bg-card px-3.5 py-2.5 text-fine/[1.6] text-muted-foreground">
                      {type.parameters.map((parameter, i) => (
                        <>
                          {i > 0 && ", "}
                          <code class="text-foreground">{parameter}</code>
                        </>
                      ))}
                    </dd>
                  </>
                ))
              }
            </dl>
            <p class:list={["mt-4", muted]}>
              <code class={code}>proto_dir</code> is relative to <code class={code}>/workspace</code>. A gRPC app with <code class={code}>reflection</code> needs
              no protos. <code class={code}>headers</code> are sent with every call. Services on the host are reached as <code class={code}
                >host.docker.internal</code
              >.
            </p>
            <p class:list={["mt-4", muted]}>
              Scripts import an app by name: <code class={code}>import {"{ Teams }"} from "teams"</code>.
            </p>

            <Figure {...figures.tree} />
          </Platform>
        </section>

        <section id="scripts" data-docs-section class={section}>
          <h2 class={legend}>Scripts</h2>
          <p class={copy}>
            Scripts are saved API calls. Click a method to create a typed call, or start with an empty script. Press <span class={key}>⌘⏎</span> to run it.
          </p>
          <div class="mt-5">
            <Snippet file="scripts/a-night-out.ts" kind="script" lang="ts" code={snippets.script} />
          </div>
          <p class:list={["mt-4", muted]}>
            A script is TypeScript with top-level <code class={code}>await</code> and an import per app. Results appear below the editor: <strong class={term}
              >Calls</strong
            > is every request and response, <strong class={term}>Canvas</strong> is what the script drew, <strong class={term}>Stats</strong> is timing percentiles.
          </p>
          <div class="mt-5 flex flex-col gap-5">
            {
              verbs.map((verb) => (
                <div class="flex flex-col gap-3">
                  {/* The sentence is copy and wraps at `copy`; the snippet under it is
                      code and takes the whole column, like every other block on the page. */}
                  <div class="flex max-w-copy flex-col gap-1 sm:flex-row sm:gap-3.5">
                    <span class="shrink-0 py-0.5 font-mono text-xs text-code-key sm:w-56">{verb.name}</span>
                    <span class="text-prose/[1.6] text-muted-foreground">{verb.says}</span>
                  </div>
                  {verb.code && <Snippet file={verb.file ?? "scripts/example.ts"} kind="script" lang="ts" code={verb.code} />}
                  {/* Figure's own `mt-8` is for standing in prose; here it belongs to
                      the snippet above it, so the block's gap is the whole spacing. */}
                  {verb.figure && (
                    <div class="[&>figure]:mt-0">
                      <Figure {...verb.figure} />
                    </div>
                  )}
                </div>
              ))
            }
          </div>
          <p class:list={["mt-5", muted]}>
            Each of these is documented where it is declared, which is also what the editor completes against and what an agent reads. The whole of it is in the{
              " "
            }
            <a href={declaration} class={link} target="_blank" rel="noopener">kaja module declaration</a>.
          </p>
          <p class:list={["mt-5", muted]}>
            <span class={key}>⌘P</span> finds a method, file or draft by name.
          </p>

          <Platform only="desktop">
            <p class:list={["mt-5", muted]}>
              An unsaved script is a <strong class={term}>draft</strong>. <strong class={term}>Save as file</strong> (<span class={key}>⌘S</span>) writes it to
              a folder on disk, listed under Files. <strong class={term}>Reveal in Finder</strong> opens that folder. Edits from another editor are picked up on the
              next run.
            </p>
          </Platform>

          <Platform only="docker">
            <p class:list={["mt-5", muted]}>
              Files is the <code class={code}>scripts</code> folder you mounted. Edit them on disk. A script written in the browser is a <strong class={term}
                >draft</strong
              >, kept in that browser only.
            </p>
          </Platform>

          <Figure {...figures.run} />
        </section>

        <section id="variables" data-docs-section class={section}>
          <h2 class={legend}>Variables</h2>
          <p class={copy}>
            A variable is a named value. Scripts read it as <code class={code}>kaja.variables.NAME</code>. App configuration expands <code class={code}
              >{"${NAME}"}</code
            > in any value, alone or inside a longer one.
          </p>

          <Platform only="desktop">
            <p class:list={["mt-5", muted]}>
              Add variables in the Variables section, <span class={key}>{"{ }"}</span> at the top of the sidebar. Each row has a source:
            </p>
            <dl class="mt-4 flex max-w-copy flex-col gap-3">
              {
                desktopSources.map((source) => (
                  <div class="flex gap-3.5">
                    <dt class="w-24 shrink-0 py-0.5 text-fine font-medium">{source.form}</dt>
                    <dd class="text-prose/[1.6] text-muted-foreground">{source.says}</dd>
                  </div>
                ))
              }
            </dl>

            <Figure {...figures.variables} />
          </Platform>

          <Platform only="docker">
            <p class:list={["mt-5", muted]}>
              Define variables in <code class={code}>kaja.json</code>.
            </p>
            <div class="mt-4">
              <Snippet file="kaja.json" kind="configuration" lang="json" code={snippets.variables} />
            </div>
            <dl class="mt-5 flex max-w-copy flex-col gap-3">
              {
                sources.map((source) => (
                  <div class="flex gap-3.5">
                    <dt class="w-24 shrink-0 py-0.5 font-mono text-xs text-code-string" set:text={source.form} />
                    <dd class="text-prose/[1.6] text-muted-foreground">
                      {source.says.map((part, i) => (i % 2 ? <code class="text-foreground">{part}</code> : part))}
                    </dd>
                  </div>
                ))
              }
            </dl>
            <div class="mt-5">
              <Note variant="watch" lead="Secrets never reach the browser.">
                <code class="text-foreground">{"${secret}"}</code> is resolved inside the container. Scripts get the placeholder, not the value.
              </Note>
            </div>
          </Platform>
        </section>

        <section id="deeplinks" data-docs-section class={section}>
          <h2 class={legend}>Deeplinks</h2>
          <p class={copy}>
            Saved scripts have deeplinks. Right-click the file, or open the menu beside Run, and pick <strong class={term}>Copy deeplink…</strong> (<span
              class={key}>⌘⇧C</span
            >).
          </p>
          <div class="mt-5">
            <Platform only="desktop">
              <Snippet file="deeplink" kind="shell" lang="shell" code={snippets.deeplinkDesktop} />
              <p class:list={["mt-4", muted]}>
                Open it with <code class={code}>open</code>, a Raycast quicklink or a Shortcut.
              </p>
            </Platform>
            <Platform only="docker">
              <Snippet file="deeplink" kind="shell" lang="shell" code={snippets.deeplinkDocker} />
            </Platform>
          </div>
          <p class:list={["mt-4", muted]}>
            The script opens with the values filled in. Press <span class={key}>⏎</span> to run it.
          </p>
          <p class:list={["mt-5", muted]}>
            The query string is <code class={code}>kaja.input</code>. Every <code class={code}>key=value</code> arrives as a string. A script run from the editor
            gets an empty input:
          </p>
          <div class="mt-4">
            <Snippet file="scripts/whats-on.ts" kind="script" lang="ts" code={snippets.deeplinkScript} />
          </div>
          <p class:list={["mt-4", muted]}>
            <strong class={term}>Run with parameters…</strong> (<span class={key}>⇧⌘⏎</span>) asks for the keys the script reads, then runs it.
          </p>
        </section>

        <section id="agents" data-docs-section class={section}>
          <h2 class={legend}>Agents</h2>
          <p class={copy}>
            Kaja exposes your APIs to agents over <a href="https://modelcontextprotocol.io" class={link} target="_blank" rel="noopener">MCP</a>. Agents can
            inspect methods, write scripts, and run them.
          </p>
          <p class:list={["mt-5", muted]}>Open the plug at the top of the sidebar. Turn the server on and copy the command or configuration for your agent.</p>

          <Platform only="desktop">
            <p class:list={["mt-5", muted]}>
              The server listens on <code class={code}>127.0.0.1:41521</code>.
            </p>

            <Figure {...figures.agent} />
          </Platform>

          <Platform only="docker">
            <p class:list={["mt-5", muted]}>
              The endpoint is Kaja's address plus <code class={code}>/mcp</code>. The token belongs to this browser. Scripts run in this tab, so keep it open
              while the agent works.
            </p>
          </Platform>

          <dl class="mt-5 flex max-w-copy flex-col gap-3">
            {
              tools.map((tool) => (
                <div class="flex gap-3.5">
                  <dt class="w-32 shrink-0 py-0.5 font-mono text-xs text-code-key" set:text={tool.name} />
                  <dd class="text-prose/[1.6] text-muted-foreground">{tool.says}</dd>
                </div>
              ))
            }
          </dl>
          <p class:list={["mt-5", muted]}>
            The agent's scripts are drafts under its name in the sidebar. Its calls land in the console. A call behind <code class={code}>kaja.approve</code> waits
            for you.
          </p>
        </section>
      </div>
    </div>
  </div>

  {
    /* Both platforms' blocks, shown together and labelled, for a reader whose
      browser never runs the toggle. */
  }
  <noscript>
    <style>
      [data-platform] {
        display: block !important;
      }

      [data-platform-label] {
        display: block;
      }
    </style>
  </noscript>

  <DocsMotion />
</Layout>
