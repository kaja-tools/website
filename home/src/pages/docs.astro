---
/* The docs: three columns — the sections, the copy, and a close-up of the
   part being read. The page is the core flow and nothing else: install,
   connect an app, run a script, keep a secret, run a script from outside,
   point an agent at it. Each section is written twice where the two builds
   differ — the desktop does everything in the UI and never shows you a file,
   the container is set up from the files you mount — and once where they
   don't, so there is one page and not two. The section list lives in
   `data/docs.ts`, which the nav and the rail read; an `id` here has to match
   one there. */
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import DocsAside from "../components/DocsAside.astro";
import DocsMotion from "../components/DocsMotion.astro";
import DocsRail from "../components/DocsRail.astro";
import Icon from "../components/Icon.astro";
import Note from "../components/Note.astro";
import Platform from "../components/Platform.astro";
import PlatformToggle from "../components/PlatformToggle.astro";
import Snippet from "../components/Snippet.astro";
import * as snippets from "../data/snippets";

const appStore = "https://apps.apple.com/us/app/kaja-for-grpc-and-twirp/id6761604205?mt=12";

const section = "scroll-mt-20 pt-16 first:pt-14";
const legend = "mb-2 font-display text-prose font-semibold tracking-[0.06em] text-muted-foreground uppercase";
const copy = "max-w-copy text-base/[1.7] text-pretty";
const muted = "max-w-copy text-base/[1.7] text-muted-foreground";
const code = "rounded-sm border border-border bg-card px-1.5 py-0.5 font-mono text-fine";
const key = "rounded-sm border border-border bg-card px-1.5 py-0.5 font-mono text-fine text-foreground";
const link = "text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground";

/* The `docker run` above, argument by argument. The mounts, the secret and
   the host alias are the ones worth spelling out; the rest are ordinary
   Docker flags nobody should have to go and look up. */
const dockerArguments = [
  { flag: "--pull always", says: "Always pull the latest image. Kaja is updated often." },
  { flag: "--name kaja", says: "Name the container, so it is one to stop and start by hand." },
  { flag: "-d", says: "Run it detached, in the background." },
  { flag: "-p 41520:41520", says: "Map the port. Kaja listens on 41520." },
  { flag: "-v .../proto:/workspace/proto", says: "The .proto files your gRPC and Twirp apps read." },
  { flag: "-v .../kaja.json:/workspace/kaja.json", says: "Your configuration: the apps and the variables, which are the next sections." },
  { flag: "-v .../scripts:/workspace/scripts", says: "Optional. A folder of .ts files, which land in the sidebar ready to run." },
  { flag: "-e KAJA_TOKEN=...", says: "Optional. The value of a variable named token that the file keeps out of itself." },
  { flag: "--add-host=host.docker.internal:host-gateway", says: "Reach a service running on the host from inside the container." },
];

/* The app types, and the parameters each one's block takes. Each wears the
   mark the app draws it with, so a type is recognised here and in the tree. */
const types = [
  { name: "grpc", parameters: ["url", "proto_dir", "reflection", "headers"] },
  { name: "twirp", parameters: ["url", "proto_dir", "headers"] },
  { name: "openapi", parameters: ["spec_url", "base_url", "headers"] },
  { name: "mcp", parameters: ["url", "headers"] },
] as const;

/* What the desktop's New app dialog asks for, type by type, in the order the
   dialog lists them. */
const forms = [
  { name: "grpc", label: "gRPC", asks: "The server's address. Kaja reads it over reflection, or you pick a folder of .proto files." },
  { name: "openapi", label: "OpenAPI", asks: "The document's URL, a file, or the document pasted in." },
  { name: "twirp", label: "Twirp", asks: "The server's address and a folder of .proto files." },
] as const;

/* Where a value in `variables` may live. `says` is split around the one
   thing in it that is itself code, which is what keeps the rows a list rather
   than hand-written ones. */
const sources = [
  { form: '"value"', says: ["The value is the value. It lives in the file."] },
  { form: '"${secret}"', says: ["Held outside the file: ", "KAJA_NAME", " in the container's environment."] },
  { form: '"${env:X}"', says: ["The environment variable ", "X", ", which may sit inside a longer value."] },
];

/* The three tools an agent gets, and what each one is for. */
const tools = [
  { name: "list_services", says: "The index: one TypeScript signature per method, marked read or write." },
  { name: "describe_method", says: "The types that signature names, and a call to start from." },
  { name: "run_script", says: "Runs it. Every call's request and response come back in the report." },
];

const description =
  "Set up Kaja on macOS or in Docker: connect gRPC, OpenAPI, Twirp and MCP apps, run scripts against them, keep secrets out of the file, and let your agent drive it over MCP.";
---

<Layout title="Docs - Kaja" description={description}>
  {
    /* Desktop is what the page opens on; the boot script swaps it for whatever
      was picked last, before anything below is painted. */
  }
  <div data-docs-platform="desktop">
    <script is:inline>
      try {
        const stored = localStorage.getItem("kaja-docs-platform");
        if (stored === "docker") document.currentScript.parentElement.dataset.docsPlatform = stored;
      } catch {}
    </script>

    <div
      class="mx-auto grid w-full max-w-doc grid-cols-1 items-start gap-10 px-6 md:px-8 lg:max-w-page lg:grid-cols-[12.25rem_minmax(0,1fr)] xl:max-w-docs xl:grid-cols-[12.25rem_minmax(32.5rem,1fr)_minmax(0,25rem)] xl:gap-14"
    >
      <DocsAside />

      <div class="min-w-0 py-10 pb-40">
        <p class="animate-rise text-xs font-semibold tracking-[0.09em] text-muted-foreground uppercase opacity-0">Documentation</p>
        <h1 class="mt-2.5 animate-rise font-display text-title font-bold tracking-display opacity-0" style={{ animationDelay: "0.06s" }}>Set up Kaja</h1>
        <p class="mt-3.5 max-w-copy animate-rise text-intro/[1.6] text-pretty text-muted-foreground opacity-0" style={{ animationDelay: "0.12s" }}>
          Install it, connect an app, press Run. The desktop app does all of it in the window; the container is set up from the files you mount. Or skip the
          install: <a href="https://demo.kaja.tools/" class={link}>the demo</a> is this same app with three apps connected.
        </p>

        {
          /* The sidebar holds the toggle at `lg` and up, and isn't there below
            it — so this is where the platform is picked on a phone. */
        }
        <div class="mt-6 max-w-64 lg:hidden">
          <PlatformToggle />
        </div>

        <section id="installation" data-docs-section class={section}>
          <h2 class={legend}>Installation</h2>

          <Platform only="desktop">
            <p class={copy}>Install from the Mac App Store. Kaja opens on Start, with nothing connected yet.</p>
            <div class="mt-5">
              <Button href={appStore} target="_blank" rel="noopener">
                <Icon name="apple" />
                Mac App Store
              </Button>
            </div>
            <p class:list={["mt-5", muted]}>Apps, variables and scripts are added from the sidebar. There is no configuration file to edit.</p>
          </Platform>

          <Platform only="docker">
            <p class={copy}>
              Kaja runs as one container and serves the UI on port 41520. The workspace is <code class={code}>/workspace</code>: mount your configuration file
              and your protos into it, and a folder of scripts if you have one.
            </p>
            <div class="mt-5">
              <Snippet file="shell" kind="shell" lang="shell" code={snippets.dockerRun} />
            </div>
            <p class:list={["mt-4", muted]}>
              Then open <a href="http://localhost:41520" class={link}>localhost:41520</a>.
            </p>
            <dl class="mt-5 flex flex-col gap-3">
              {
                dockerArguments.map((argument) => (
                  <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                    <dt class="shrink-0 py-0.5 font-mono text-xs text-code-key sm:w-84">{argument.flag}</dt>
                    <dd class="text-prose/[1.6] text-muted-foreground">{argument.says}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="mt-5">
              <Note variant="watch" lead="The workspace is read-only.">
                The browser shows the apps, variables and scripts you mounted and never writes to them. Edit the files instead, so the workspace can be checked
                in and deployed with the container.
              </Note>
            </div>
          </Platform>
        </section>

        <section id="apps" data-docs-section class={section}>
          <h2 class={legend}>Apps</h2>

          <Platform only="desktop">
            <p class={copy}>
              An app is one API Kaja can call. Press <span class={key}>+</span> beside <strong class="font-medium text-foreground">Apps</strong> in the sidebar and
              pick a type. Each one asks for one thing:
            </p>
            <dl class="mt-5 grid grid-cols-[6rem_1fr] gap-px overflow-hidden rounded-frame border border-border bg-border">
              {
                forms.map((form) => (
                  <>
                    <dt class="flex items-center gap-2 bg-card px-3.5 py-2.5 text-fine font-medium">
                      <Icon name={form.name} size={14} class="shrink-0 text-muted-foreground" />
                      {form.label}
                    </dt>
                    <dd class="bg-card px-3.5 py-2.5 text-fine/[1.6] text-muted-foreground">{form.asks}</dd>
                  </>
                ))
              }
            </dl>
            <p class:list={["mt-5", muted]}>
              Kaja reads the server before it saves anything, so a wrong address or a missing token is reported in the form. The credential and any header every
              call should carry are on the same form. On save, every service and method the app exposes appears in the tree.
            </p>
          </Platform>

          <Platform only="docker">
            <p class={copy}>
              An app is one API Kaja can call. Every entry in <code class={code}>apps</code> is a <code class={code}>name</code> plus one block, and the block's key
              is the type.
            </p>
            <div class="mt-5">
              <Snippet file="kaja.json" kind="configuration" lang="json" code={snippets.apps} />
            </div>
            <dl class="mt-5 grid grid-cols-[7rem_1fr] gap-px overflow-hidden rounded-frame border border-border bg-border">
              {
                types.map((type) => (
                  <>
                    <dt class="flex items-center gap-2 bg-card px-3.5 py-2.5 font-mono text-xs text-code-key">
                      <Icon name={type.name} size={14} class="shrink-0 text-muted-foreground" />
                      {type.name}
                    </dt>
                    <dd class="bg-card px-3.5 py-2.5 text-fine/[1.6] text-muted-foreground">
                      {type.parameters.map((parameter, i) => (
                        <>
                          {i > 0 && ", "}
                          <code class="text-foreground">{parameter}</code>
                        </>
                      ))}
                    </dd>
                  </>
                ))
              }
            </dl>
            <p class:list={["mt-4", muted]}>
              <code class={code}>proto_dir</code> is relative to <code class={code}>/workspace</code>, so it names a folder inside the one you mounted; a gRPC
              app with <code class={code}>reflection</code> needs no protos at all. <code class={code}>headers</code> go out with every call. A service on the host
              is reached as <code class={code}>host.docker.internal</code>.
            </p>
            <p class:list={["mt-4", muted]}>
              The name is what a script imports: <code class={code}>import {"{ Teams }"} from "teams"</code>.
            </p>
          </Platform>
        </section>

        <section id="scripts" data-docs-section class={section}>
          <h2 class={legend}>Scripts</h2>
          <p class={copy}>
            Click a method in the tree. Kaja drafts the call in a script, typed against that app, and <span class={key}>⌘⏎</span> runs it. The run appears below the
            editor: <strong class="font-medium text-foreground">Calls</strong> is every call it made, with the request, the response and the headers;{" "}
            <strong class="font-medium text-foreground">Canvas</strong> is what the script drew; <strong class="font-medium text-foreground">Stats</strong> is the
            percentiles.
          </p>
          <div class="mt-5">
            <Snippet file="scripts/a-night-out.ts" kind="script" lang="ts" code={snippets.script} />
          </div>
          <p class:list={["mt-4", muted]}>
            A script is TypeScript with top-level <code class={code}>await</code> and an import per app. <code class={code}>kaja.table</code>, <code
              class={code}>kaja.text</code
            > and <code class={code}>kaja.code</code> draw on the canvas; <code class={code}>kaja.askStr</code> stops the run to ask you something; <code
              class={code}>kaja.approve</code
            > holds a call on the canvas until you press Approve, which is where writes belong. <code class={code}>⌘P</code> finds any method, file or draft by name.
          </p>

          <Platform only="desktop">
            <p class:list={["mt-5", muted]}>
              A script you haven't named is a <strong class="font-medium text-foreground">draft</strong>, kept under Drafts until you discard it. <strong
                class="font-medium text-foreground">Save as file</strong
              > (<span class={key}>⌘S</span>) names it and moves it under Files, which is a folder on disk: <strong class="font-medium text-foreground"
                >Reveal in Finder</strong
              >, in the menu beside Run, opens it, and a file edited in your own editor is picked up on the next run.
            </p>
          </Platform>

          <Platform only="docker">
            <p class:list={["mt-5", muted]}>
              Files are the <code class={code}>scripts</code> folder you mounted, one entry per <code class={code}>.ts</code> file, ready to run. The browser can't
              write them, so they are edited on disk. A script you write in the browser is a <strong class="font-medium text-foreground">draft</strong>, kept in
              this browser only: copy it into the folder to keep it.
            </p>
          </Platform>
        </section>

        <section id="variables" data-docs-section class={section}>
          <h2 class={legend}>Variables</h2>

          <Platform only="desktop">
            <p class={copy}>
              A variable is a named value. A script reads it as <code class={code}>kaja.variables.NAME</code>, and any field of an app's form takes <code
                class={code}>{"${NAME}"}</code
              > in place of the value, inside a longer one too.
            </p>
            <p class:list={["mt-5", muted]}>
              Open them from <span class={key}>{"{ }"}</span> at the top of the sidebar. Each row picks where its value lives: <strong
                class="font-medium text-foreground">Value</strong
              >, typed in; <strong class="font-medium text-foreground">Keychain</strong>, held by macOS, which is where a token goes; <strong
                class="font-medium text-foreground">Environment</strong
              >, read from a variable of the machine. The table saves as you type, and the last column says which apps and files use each one.
            </p>
          </Platform>

          <Platform only="docker">
            <p class={copy}>
              A variable is a named value. A script reads it as <code class={code}>kaja.variables.NAME</code>, and the configuration expands <code class={code}
                >{"${NAME}"}</code
              > anywhere in a value, inside a longer one too.
            </p>
            <div class="mt-5">
              <Snippet file="kaja.json" kind="configuration" lang="json" code={snippets.variables} />
            </div>
            <dl class="mt-5 flex max-w-copy flex-col gap-3">
              {
                sources.map((source) => (
                  <div class="flex gap-3.5">
                    <dt class="w-24 shrink-0 py-0.5 font-mono text-xs text-code-string" set:text={source.form} />
                    <dd class="text-prose/[1.6] text-muted-foreground">
                      {source.says.map((part, i) => (i % 2 ? <code class="text-foreground">{part}</code> : part))}
                    </dd>
                  </div>
                ))
              }
            </dl>
            <div class="mt-5">
              <Note variant="watch" lead="A secret never reaches the browser.">
                <code class="text-foreground">{"${secret}"}</code> is resolved inside the container, which is what keeps the file safe to commit. The Variables page
                shows each name and whether it resolved, and a script sees the file's own text.
              </Note>
            </div>
          </Platform>
        </section>

        <section id="deeplinks" data-docs-section class={section}>
          <h2 class={legend}>Deeplinks</h2>
          <p class={copy}>
            A saved script has a URL, so anything that opens one can run it. Right-click the file, or open the menu beside Run, and pick <strong
              class="font-medium text-foreground">Copy deeplink…</strong
            > (<span class={key}>⌘⇧C</span>).
          </p>
          <div class="mt-5">
            <Platform only="desktop">
              <Snippet file="deeplink" kind="shell" lang="shell" code={snippets.deeplinkDesktop} />
              <p class:list={["mt-4", muted]}>
                Use it in a Raycast quicklink, a Shortcut, or with <code class={code}>open</code> in a shell. The script opens with the values filled in, and <span
                  class={key}>⏎</span
                > runs it.
              </p>
            </Platform>
            <Platform only="docker">
              <Snippet file="deeplink" kind="shell" lang="shell" code={snippets.deeplinkDocker} />
              <p class:list={["mt-4", muted]}>
                The page's own address, with the link after the <code class={code}>#</code>, so it works as a bookmark or a link in a document. The script opens
                with the values filled in, and <span class={key}>⏎</span> runs it.
              </p>
            </Platform>
          </div>
          <p class:list={["mt-5", muted]}>
            The query string is the script's input: every <code class={code}>key=value</code> arrives as text in <code class={code}>kaja.input</code>, and the
            sheet lists the keys the script reads. A script run from the editor gets an empty input, so ask for what the link didn't pass:
          </p>
          <div class="mt-4">
            <Snippet file="scripts/whats-on.ts" kind="script" lang="ts" code={snippets.deeplinkScript} />
          </div>
          <p class:list={["mt-4", muted]}>
            <strong class="font-medium text-foreground">Run with parameters…</strong> (<span class={key}>⇧⌘⏎</span>) in the same menu runs it from the app with
            the same sheet.
          </p>
        </section>

        <section id="agents" data-docs-section class={section}>
          <h2 class={legend}>Agents</h2>
          <p class={copy}>
            Kaja is an <a href="https://modelcontextprotocol.io" class={link} target="_blank" rel="noopener">MCP</a> server, so an agent can read what your apps expose,
            write a script against them and run it. Open the plug at the top of the sidebar: the page carries the endpoint and the token, the switch that turns the
            server on, and a row per agent with the exact command or configuration it takes, ready to copy.
          </p>

          <Platform only="desktop">
            <p class:list={["mt-5", muted]}>
              The server listens on <code class={code}>127.0.0.1:41521</code>, so only this Mac can reach it, and the token survives turning the server off.
              Claude Code, Claude Desktop, Cursor, VS Code, Codex CLI, Windsurf, Zed, Cline, Goose and Gemini CLI are listed.
            </p>
          </Platform>

          <Platform only="docker">
            <p class:list={["mt-5", muted]}>
              The endpoint is the page's own address plus <code class={code}>/mcp</code>, and the token is this browser's. An agent can connect only while the
              switch is on, and runs are carried out in this window, so keep it open while the agent works.
            </p>
          </Platform>

          <dl class="mt-5 flex max-w-copy flex-col gap-3">
            {
              tools.map((tool) => (
                <div class="flex gap-3.5">
                  <dt class="w-32 shrink-0 py-0.5 font-mono text-xs text-code-key" set:text={tool.name} />
                  <dd class="text-prose/[1.6] text-muted-foreground">{tool.says}</dd>
                </div>
              ))
            }
          </dl>
          <p class:list={["mt-5", muted]}>
            Every step is visible. Its script is a draft pinned at the top of the sidebar under the agent's name, every call lands in the console beside your
            own, and a call it puts behind <code class={code}>kaja.approve</code> waits for you.
          </p>
        </section>
      </div>

      <DocsRail />
    </div>
  </div>

  {
    /* Both platforms' blocks, shown together and labelled, for a reader whose
      browser never runs the toggle. */
  }
  <noscript>
    <style>
      [data-platform] {
        display: block !important;
      }

      [data-platform-label] {
        display: block;
      }
    </style>
  </noscript>

  <DocsMotion />
</Layout>
