---
/* The hero, which is the map the app draws on its MCP page
   (`ui/src/McpMap.tsx`), ported stroke for stroke: an agent on the left, Kaja
   in the middle drawn as its own canvas, and the four protocols it speaks on
   the right. There is no screenshot here — the app is shown further down the
   page, and a picture of the window would say what this already says, twice.

   Three weights and no colour, as in the app: `wire` for the wires and the
   canvas's own blocks, `muted-foreground` for the node frames and the arrows,
   `foreground` for names and marks. The site's own layer over it is the
   entrance — the map rises, the wires draw themselves, the arrows land last.

   Below `md` the drawing is too small to read, so the same five things are a
   plain stack of cards with the two labels between them.

   The one thing not ported verbatim is the width of the app cards: the site's
   body face is wider than the app's, and `OpenAPI` ran into `schema`. */
import Icon from "./Icon.astro";

/* The apps down the right-hand side, each with the one word its surface is
   read from, and the y its 44px card sits at. */
const apps = [
  { name: "gRPC", mark: "grpc", source: ".proto", y: 40 },
  { name: "OpenAPI", mark: "openapi", source: "schema", y: 100 },
  { name: "MCP", mark: "mcp", source: "tools", y: 160 },
  { name: "Twirp", mark: "twirp", source: ".proto", y: 220 },
] as const;

/* `pathLength` normalises every wire to 1, so one dash offset animates them
   all however long they are. */
const wires = [
  { d: "M220 150 H 340", delay: "0.45s" },
  { d: "M540 150 C 600 150, 620 62, 680 62", delay: "0.65s" },
  { d: "M540 150 C 600 150, 620 122, 680 122", delay: "0.75s" },
  { d: "M540 150 C 600 150, 620 182, 680 182", delay: "0.85s" },
  { d: "M540 150 C 600 150, 620 242, 680 242", delay: "0.95s" },
];

const caption = "every call lands here, for you to see and approve";

const card = "rounded-lg border border-border bg-card px-4 py-3.5";
const stackLabel = "text-center font-mono text-micro tracking-[0.12em] text-muted-foreground uppercase";
---

<div class="mx-auto w-full max-w-page px-6 md:px-8">
  <svg
    viewBox="0 0 880 300"
    role="img"
    aria-label="An agent writes and runs a script over MCP; every call it makes lands on Kaja's canvas, and Kaja speaks gRPC, OpenAPI, MCP and Twirp to your apps."
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="mx-auto hidden w-full max-w-map animate-rise opacity-0 md:block"
    style={{ animationDelay: "0.3s" }}
  >
    {
      wires.map((wire) => (
        <path
          class="animate-draw stroke-wire"
          pathLength="1"
          stroke-dasharray="1"
          stroke-dashoffset="1"
          stroke-width="1.5"
          d={wire.d}
          style={{ animationDelay: wire.delay }}
        />
      ))
    }
    <g class="animate-rise stroke-muted-foreground opacity-0" stroke-width="1.5" style={{ animationDelay: "1.35s" }}>
      <path d="M334 146l6 4-6 4M674 58l6 4-6 4M674 118l6 4-6 4M674 178l6 4-6 4M674 238l6 4-6 4"></path>
    </g>

    <text x="270" y="140" text-anchor="middle" font-size="10.5" letter-spacing="1.2" class="fill-muted-foreground font-mono">MCP</text>
    <text x="610" y="112" text-anchor="middle" font-size="10.5" letter-spacing="1.2" class="fill-muted-foreground font-mono">CALLS</text>

    <rect x="20" y="110" width="200" height="80" rx="8" class="fill-card stroke-muted-foreground" stroke-width="1.5"></rect>
    {
      /* Drawn rather than taken from the icon set: the antenna is centred,
        which is what keeps this bot from reading as a second mark in a
        picture full of marks. */
    }
    <g transform="translate(40 134)" class="stroke-foreground" stroke-width="2">
      <rect x="3" y="8" width="18" height="13" rx="3"></rect>
      <path d="M12 8V4M9 4h6"></path>
      <path d="M8.5 14.5v.01M15.5 14.5v.01"></path>
    </g>
    <text x="74" y="146" font-size="13" font-weight="600" class="fill-foreground">An agent</text>
    <text x="74" y="164" font-size="11" class="fill-muted-foreground">writes the script, runs it</text>

    <g class="stroke-muted-foreground" stroke-width="1.5">
      <rect x="340" y="60" width="200" height="180" rx="8" class="fill-card stroke-muted-foreground"></rect>
      <path d="M340 90h200"></path>
    </g>
    {
      /* The Kaja mark at the size this drawing can carry it, in stroke rather
        than in its gradient: the map has three weights and no colour. */
    }
    <path d="M356 75h5l3-6 4 12 3-6h5" stroke-width="2" class="stroke-foreground"></path>
    <text x="384" y="79" font-size="13" font-weight="600" class="fill-foreground">Kaja</text>
    <text x="524" y="79" text-anchor="end" font-size="10" class="fill-muted-foreground">canvas</text>
    <g class="stroke-wire" stroke-width="1.5">
      <path d="M358 110h96M358 122h64"></path>
      <rect x="358" y="138" width="164" height="42" rx="3"></rect>
      <path d="M358 152h164M413 138v42M468 138v42"></path>
      <rect x="358" y="194" width="164" height="30" rx="3"></rect>
    </g>
    <g class="stroke-muted-foreground" stroke-width="1.5">
      <path d="M370 209h4l2-4 3 8 2-4h4"></path>
      <path d="M394 209h78"></path>
      <path d="M496 205l3 4 6-8"></path>
    </g>
    <text x="440" y="270" text-anchor="middle" font-size="11" class="fill-muted-foreground">{caption}</text>

    {
      apps.map((app) => (
        <>
          <rect x="680" y={app.y} width="180" height="44" rx="8" class="fill-card stroke-muted-foreground" stroke-width="1.5" />
          <g transform={`translate(694 ${app.y + 12})`} class="text-foreground">
            <Icon name={app.mark} size={20} />
          </g>
          <text x="724" y={app.y + 26} font-size="13" font-weight="600" class="fill-foreground">
            {app.name}
          </text>
          <text x="846" y={app.y + 26} text-anchor="end" font-size="11" class="fill-muted-foreground font-mono">
            {app.source}
          </text>
        </>
      ))
    }
  </svg>

  <div class="mx-auto flex max-w-tagline animate-rise flex-col gap-3 opacity-0 md:hidden" style={{ animationDelay: "0.3s" }}>
    <div class={card}>
      <p class="text-fine font-medium">An agent</p>
      <p class="mt-1 text-xs/[1.4] text-muted-foreground">writes the script, runs it</p>
    </div>
    <p class={stackLabel}>MCP</p>
    <div class={card}>
      <p class="text-fine font-medium">Kaja</p>
      <p class="mt-1 text-xs/[1.4] text-muted-foreground">{caption}</p>
    </div>
    <p class={stackLabel}>Calls</p>
    {
      apps.map((app) => (
        <div class="flex items-center gap-2.5 rounded-lg border border-border bg-card px-4 py-3">
          <Icon name={app.mark} class="shrink-0 text-muted-foreground" />
          <span class="text-fine font-medium">{app.name}</span>
          <span class="ml-auto font-mono text-micro text-muted-foreground">{app.source}</span>
        </div>
      ))
    }
  </div>
</div>
