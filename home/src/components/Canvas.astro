---
/* The hero, which is the map the app draws on its MCP page
   (`ui/src/McpMap.tsx`), ported stroke for stroke: an agent, Kaja in the
   middle drawn as its own canvas, and the four protocols it speaks. There is
   no screenshot here — the app is shown further down the page, and a picture
   of the window would say what this already says, twice.

   Three weights and no colour, as in the app: `wire` for the wires and the
   canvas's own blocks, `muted-foreground` for the node frames and the arrows,
   `foreground` for names and marks. The site's own layer over it is the
   entrance — the map rises, the wires draw themselves, the arrows land last.

   Two layouts, one drawing. The map runs left to right where there is room
   for it; below `md` the same five nodes are stacked down the page and the
   four protocols hang off a spine, because the landscape drawing scaled to a
   phone is a picture of text nobody can read. The nodes themselves are
   `MapAgent`, `MapKaja` and `MapApp`, each drawn from its own origin so both
   layouts place the same strokes.

   Two things are not ported verbatim: the width of the app cards, because the
   site's body face is wider than the app's and `OpenAPI` ran into `schema`,
   and the viewBox, which is cropped to the drawing so the hero fits a 13-inch
   screen rather than paying for the app's own margins twice. */
import MapAgent from "./MapAgent.astro";
import MapApp from "./MapApp.astro";
import MapKaja from "./MapKaja.astro";

/* The apps, each with the one word its surface is read from, and the y its
   44px card sits at in either layout. */
const apps = [
  { name: "gRPC", mark: "grpc", source: ".proto", wide: 40, tall: 376 },
  { name: "OpenAPI", mark: "openapi", source: "schema", wide: 100, tall: 432 },
  { name: "MCP", mark: "mcp", source: "tools", wide: 160, tall: 488 },
  { name: "Twirp", mark: "twirp", source: ".proto", wide: 220, tall: 544 },
] as const;

/* `pathLength` normalises every wire to 1, so one dash offset animates them
   all however long they are. */
const wires = [
  { d: "M220 150 H 340", delay: "0.45s" },
  { d: "M540 150 C 600 150, 620 62, 680 62", delay: "0.65s" },
  { d: "M540 150 C 600 150, 620 122, 680 122", delay: "0.75s" },
  { d: "M540 150 C 600 150, 620 182, 680 182", delay: "0.85s" },
  { d: "M540 150 C 600 150, 620 242, 680 242", delay: "0.95s" },
];

/* Stacked, the four wires are one spine down the left with a stub into each
   card, because four curves from one point to four boxes under it cross. */
const stackedWires = [
  { d: "M122 80 V 122", delay: "0.45s" },
  { d: "M62 302 C 38 302, 26 314, 26 336 V 566", delay: "0.6s" },
  { d: "M26 398 H 36", delay: "0.95s" },
  { d: "M26 454 H 36", delay: "1s" },
  { d: "M26 510 H 36", delay: "1.05s" },
  { d: "M26 566 H 36", delay: "1.1s" },
];

/* One sentence, set on two lines where the column is a phone wide. */
const captionLines = ["every call lands here,", "for you to see and approve"];
const caption = captionLines.join(" ");

const label =
  "An agent writes and runs a script over MCP; every call it makes lands on Kaja's canvas, and Kaja speaks gRPC, OpenAPI, MCP and Twirp to your apps.";
const wire = "animate-draw stroke-wire";
---

<div class="mx-auto w-full max-w-page px-6 md:px-8">
  <svg
    viewBox="0 30 880 253"
    role="img"
    aria-label={label}
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="mx-auto hidden w-full max-w-map animate-rise opacity-0 md:block"
    style={{ animationDelay: "0.3s" }}
  >
    {
      wires.map((w) => (
        <path class={wire} pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" stroke-width="1.5" d={w.d} style={{ animationDelay: w.delay }} />
      ))
    }
    <g class="animate-rise stroke-muted-foreground opacity-0" stroke-width="1.5" style={{ animationDelay: "1.35s" }}>
      <path d="M334 146l6 4-6 4M674 58l6 4-6 4M674 118l6 4-6 4M674 178l6 4-6 4M674 238l6 4-6 4"></path>
    </g>

    <text x="270" y="140" text-anchor="middle" font-size="10.5" letter-spacing="1.2" class="fill-muted-foreground font-mono">MCP</text>
    <text x="610" y="112" text-anchor="middle" font-size="10.5" letter-spacing="1.2" class="fill-muted-foreground font-mono">CALLS</text>

    <g transform="translate(20 110)"><MapAgent /></g>
    <g transform="translate(340 60)"><MapKaja /></g>
    <text x="440" y="270" text-anchor="middle" font-size="11" class="fill-muted-foreground">{caption}</text>
    {
      apps.map((app) => (
        <g transform={`translate(680 ${app.wide})`}>
          <MapApp name={app.name} mark={app.mark} source={app.source} />
        </g>
      ))
    }
  </svg>

  <svg
    viewBox="0 0 240 596"
    role="img"
    aria-label={label}
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="mx-auto w-full max-w-map-portrait animate-rise opacity-0 md:hidden"
    style={{ animationDelay: "0.3s" }}
  >
    {
      stackedWires.map((w) => (
        <path class={wire} pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" stroke-width="1.5" d={w.d} style={{ animationDelay: w.delay }} />
      ))
    }
    <g class="animate-rise stroke-muted-foreground opacity-0" stroke-width="1.5" style={{ animationDelay: "1.35s" }}>
      <path d="M118 116l4 6 4-6M36 394l6 4-6 4M36 450l6 4-6 4M36 506l6 4-6 4M36 562l6 4-6 4"></path>
    </g>

    <text x="132" y="106" font-size="10.5" letter-spacing="1.2" class="fill-muted-foreground font-mono">MCP</text>
    <text x="42" y="362" font-size="10.5" letter-spacing="1.2" class="fill-muted-foreground font-mono">CALLS</text>

    <g transform="translate(22 0)"><MapAgent /></g>
    <g transform="translate(22 122)"><MapKaja /></g>
    {
      captionLines.map((line, i) => (
        <text x="131" y={326 + i * 14} text-anchor="middle" font-size="10" class="fill-muted-foreground">
          {line}
        </text>
      ))
    }
    {
      apps.map((app) => (
        <g transform={`translate(42 ${app.tall})`}>
          <MapApp name={app.name} mark={app.mark} source={app.source} />
        </g>
      ))
    }
  </svg>
</div>
