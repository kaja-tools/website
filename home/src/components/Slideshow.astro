---
interface Props {
  slides: { src: string; alt: string }[];
}

const { slides } = Astro.props;
---

<section class="animate-fade-in pt-4 pb-12 [animation-delay:0.1s]">
  <div data-slideshow class="relative mx-auto max-w-shot overflow-hidden rounded-2xl bg-surface shadow-frame">
    {
      slides.map((slide, i) => (
        <div class="hidden w-full data-[active]:block" data-slide data-active={i === 0 ? "" : undefined}>
          <img src={slide.src} alt={slide.alt} class="block h-auto w-full" />
        </div>
      ))
    }
  </div>
  <div class="mt-6 flex justify-center gap-2">
    {
      slides.map((_, i) => (
        <button
          type="button"
          data-dot
          data-active={i === 0 ? "" : undefined}
          aria-label={`Go to slide ${i + 1}`}
          class="size-2.5 cursor-pointer rounded-full bg-white/20 transition-all duration-300 hover:bg-white/40 data-[active]:scale-[1.2] data-[active]:bg-accent"
        />
      ))
    }
  </div>
</section>

<script>
  const container = document.querySelector<HTMLElement>("[data-slideshow]");
  const slides = document.querySelectorAll<HTMLElement>("[data-slide]");
  const dots = document.querySelectorAll<HTMLElement>("[data-dot]");

  if (slides.length > 0) {
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(index: number) {
      // Wrap around in both directions.
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.toggleAttribute("data-active", i === current));
      dots.forEach((dot, i) => dot.toggleAttribute("data-active", i === current));
    }

    function start() {
      if (slides.length > 1 && timer === null) {
        timer = setInterval(() => show(current + 1), 5000);
      }
    }

    function stop() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Any manual move restarts the clock, so a slide the visitor just picked
    // gets a full interval rather than whatever was left of the current one.
    function goTo(index: number) {
      stop();
      show(index);
      start();
    }

    dots.forEach((dot, index) => dot.addEventListener("click", () => goTo(index)));

    document.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") goTo(current - 1);
      else if (event.key === "ArrowRight") goTo(current + 1);
    });

    container?.addEventListener("mouseenter", stop);
    container?.addEventListener("mouseleave", start);

    start();
  }
</script>
