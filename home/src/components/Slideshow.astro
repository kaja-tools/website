---
interface Props {
  slides: { src: string; width: number; height: number }[];
  /* What the window frame claims to be showing, in its title bar. */
  label: string;
}

const { slides, label } = Astro.props;
---

<div data-slideshow>
  <div class="overflow-hidden rounded-frame border border-border bg-card shadow-frame" data-frame>
    <div class="flex h-9.5 items-center gap-3 border-b border-border bg-background px-3">
      <div class="flex gap-1.5">
        <span class="size-2.5 rounded-full bg-muted"></span>
        <span class="size-2.5 rounded-full bg-muted"></span>
        <span class="size-2.5 rounded-full bg-muted"></span>
      </div>
      <span class="font-mono text-xs text-muted-foreground">{label}</span>
    </div>
    {
      slides.map((slide, i) => (
        <div id={`screenshot-panel-${i + 1}`} role="tabpanel" aria-labelledby={`screenshot-tab-${i + 1}`} hidden={i !== 0} data-panel>
          <img src={slide.src} width={slide.width} height={slide.height} alt={`Kaja application screenshot ${i + 1}`} class="block h-auto w-full" />
        </div>
      ))
    }
  </div>
  <div class="mt-5 flex justify-center">
    <div role="tablist" aria-label="Screenshot" class="inline-flex items-center gap-0.5 rounded-md border border-border bg-muted p-0.5">
      {
        slides.map((_, i) => (
          <button
            type="button"
            role="tab"
            id={`screenshot-tab-${i + 1}`}
            aria-controls={`screenshot-panel-${i + 1}`}
            aria-selected={i === 0}
            tabindex={i === 0 ? 0 : -1}
            data-tab
            data-active={i === 0 ? "" : undefined}
            class="inline-flex items-center rounded-sm px-2.5 py-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none data-[active]:bg-background data-[active]:text-foreground data-[active]:shadow-sm"
          >
            {i + 1}
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-slideshow]");
  const frame = root?.querySelector<HTMLElement>("[data-frame]");
  const panels = [...(root?.querySelectorAll<HTMLElement>("[data-panel]") ?? [])];
  const tabs = [...(root?.querySelectorAll<HTMLButtonElement>("[data-tab]") ?? [])];

  if (panels.length > 1) {
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(index: number) {
      // Wrap around in both directions.
      current = (index + panels.length) % panels.length;
      panels.forEach((panel, i) => (panel.hidden = i !== current));
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === current));
        // Roving tabindex: the tablist is one tab stop, and the arrow keys
        // move within it.
        tab.tabIndex = i === current ? 0 : -1;
        tab.toggleAttribute("data-active", i === current);
      });
    }

    function start() {
      timer ??= setInterval(() => show(current + 1), 5000);
    }

    function stop() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Any manual move restarts the clock, so a slide the visitor just picked
    // gets a full interval rather than whatever was left of the current one.
    function goTo(index: number) {
      stop();
      show(index);
      start();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => goTo(index));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        goTo(current + (event.key === "ArrowRight" ? 1 : -1));
        tabs[current].focus();
      });
    });

    frame?.addEventListener("mouseenter", stop);
    frame?.addEventListener("mouseleave", start);

    start();
  }
</script>
