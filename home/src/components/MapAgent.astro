---
/* The agent node of the hero map, drawn from its own origin so the landscape
   and the portrait layout can each place it where they need it. 200x80. */
---

<rect width="200" height="80" rx="8" class="fill-card stroke-muted-foreground" stroke-width="1.5"></rect>
{
  /* Drawn rather than taken from the icon set: the antenna is centred, which
    is what keeps this bot from reading as a second mark in a picture full of
    marks. */
}
<g transform="translate(20 24)" class="stroke-foreground" stroke-width="2">
  <rect x="3" y="8" width="18" height="13" rx="3"></rect>
  <path d="M12 8V4M9 4h6"></path>
  <path d="M8.5 14.5v.01M15.5 14.5v.01"></path>
</g>
<text x="54" y="36" font-size="13" font-weight="600" class="fill-foreground">An agent</text>
<text x="54" y="54" font-size="11" class="fill-muted-foreground">writes the script, runs it</text>
