---
/* The one scroll listener on the site. Everything scroll-driven is a data
   attribute this reads, so a section stays plain markup:

     data-reveal      fades and lifts into place the first time it is seen
     data-parallax    drifts by its value's share of the scroll past it
     data-hero-shot   scales up a little as the page leaves the hero
     data-pin         a pinned section, whose panes swap as it scrolls by

   All of it is decorative, so a visitor who asked for less motion gets the
   finished state and no listener at all. Drift and the swap are also `lg` and
   up only: below that the pinned section is a plain stacked list. */
---

<script>
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");
  const wide = window.matchMedia("(min-width: 64rem)");

  const drifters = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
  const heroShot = document.querySelector<HTMLElement>("[data-hero-shot]");
  const pin = document.querySelector<HTMLElement>("[data-pin]");
  const texts = [...document.querySelectorAll<HTMLElement>("[data-pane-text]")];
  const bars = [...document.querySelectorAll<HTMLElement>("[data-pane-bar]")];
  const shots = [...document.querySelectorAll<HTMLElement>("[data-pane-shot]")];

  // -1 is "the panes are showing themselves", which is both the state below
  // `lg` and the state before the first measurement.
  let live = -1;

  function drift(viewport: number) {
    for (const el of drifters) {
      if (!wide.matches) {
        el.style.transform = "";
        continue;
      }
      const rate = Number(el.dataset.parallax) || 0;
      const box = el.getBoundingClientRect();
      // How far the card's centre is from the viewport's, in viewports.
      const off = (box.top + box.height / 2 - viewport / 2) / viewport;
      el.style.transform = `translate3d(0, ${(-off * rate * 70).toFixed(1)}px, 0)`;
    }
  }

  function zoom() {
    if (!heroShot) return;
    const progress = Math.min(1, Math.max(0, window.scrollY / 900));
    heroShot.style.transform = `scale(${(1 + progress * 0.07).toFixed(4)})`;
  }

  function swap(viewport: number) {
    if (!pin) return;

    if (!wide.matches) {
      if (live === -1) return;
      live = -1;
      for (const el of [...texts, ...bars, ...shots]) el.style.cssText = "";
      return;
    }

    const box = pin.getBoundingClientRect();
    const travel = Math.max(1, box.height - viewport);
    const progress = Math.min(0.9999, Math.max(0, -box.top / travel));
    const index = Math.floor(progress * texts.length);
    if (index === live) return;
    live = index;

    texts.forEach((el, i) => (el.style.opacity = i === index ? "1" : "0.32"));
    bars.forEach((el, i) => (el.style.background = i === index ? "var(--color-foreground)" : "var(--color-border)"));
    shots.forEach((el, i) => {
      el.style.opacity = i === index ? "1" : "0";
      el.style.transform = i === index ? "translateY(0)" : `translateY(${i < index ? "-18px" : "18px"})`;
    });
  }

  function frame() {
    const viewport = window.innerHeight;
    if (!still.matches) {
      drift(viewport);
      zoom();
    }
    // The swap runs either way: it is how the pinned section shows its second
    // and third pane, and the reduced-motion rule already made it instant.
    swap(viewport);
  }

  if (!still.matches) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.style.opacity = "1";
          el.style.transform = "none";
          seen.unobserve(el);
        }
      },
      { threshold: 0.12 },
    );

    // Hidden from script rather than from CSS, so the page reads whole to
    // anyone who never runs it.
    for (const el of document.querySelectorAll<HTMLElement>("[data-reveal]")) {
      el.style.opacity = "0";
      el.style.transform = "translateY(26px)";
      el.style.transition = "opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1)";
      seen.observe(el);
    }
  }

  window.addEventListener("scroll", frame, { passive: true });
  window.addEventListener("resize", frame);
  wide.addEventListener("change", frame);
  frame();
</script>
