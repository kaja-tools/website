---
/* The one scroll listener on the site. Everything scroll-driven is a data
   attribute this reads, so a section stays plain markup:

     data-parallax    drifts by its value's share of the scroll past it
     data-ink-item    a statement, a crop, and the red line drawn between them

   Drift is decorative and drops out for a visitor who asked for less motion,
   and it is `lg` and up only, because below that a statement sits above its
   crop and there is nothing to pull apart. The ink runs either way: the line
   and the box are how an item points at the thing it is talking about, and the
   reduced-motion rule already collapsed the drawing to an instant. */
---

<script>
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");
  const wide = window.matchMedia("(min-width: 64rem)");

  const drifters = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
  const items = [...document.querySelectorAll<HTMLElement>("[data-ink-item]")];

  // The items whose line has already been drawn. It is drawn once, when the
  // crop first comes halfway into view, and stays.
  const drawn = new Set<HTMLElement>();

  function drift(viewport: number) {
    for (const el of drifters) {
      if (!wide.matches) {
        el.style.transform = "";
        continue;
      }
      const rate = Number(el.dataset.parallax) || 0;
      const box = el.getBoundingClientRect();
      // How far the half's centre is from the viewport's, in viewports.
      const off = (box.top + box.height / 2 - viewport / 2) / viewport;
      el.style.transform = `translate3d(0, ${(-off * rate * 70).toFixed(1)}px, 0)`;
    }
  }

  function ink(viewport: number) {
    for (const item of items) {
      const statement = item.querySelector<HTMLElement>("[data-statement]");
      const crop = item.querySelector<HTMLElement>("[data-crop]");
      const dot = item.querySelector<SVGCircleElement>("[data-dot]");
      const line = item.querySelector<SVGPathElement>("[data-line]");
      const box = item.querySelector<SVGRectElement>("[data-box]");
      if (!statement || !crop || !dot || !line || !box) continue;

      // Measured rather than written down: both halves drift as the page
      // scrolls, so where they are is only known here.
      const base = item.getBoundingClientRect();
      const s = statement.getBoundingClientRect();
      const c = crop.getBoundingClientRect();

      // The highlight box, in fractions of the crop, placed in the item.
      const [hx, hy, hw, hh] = (item.dataset.highlight ?? "").split(",").map(Number);
      const left = c.left - base.left + hx * c.width;
      const top = c.top - base.top + hy * c.height;
      const width = hw * c.width;
      const height = hh * c.height;
      const right = left + width;
      const bottom = top + height;

      // Where the line leaves the statement, and the path it takes to the box:
      // straight in if the two already line up, one right-angled turn if not.
      const beside = c.right <= s.left || c.left >= s.right;
      let ax: number;
      let ay: number;
      let path: string;

      if (beside) {
        const cropLeft = c.right <= s.left;
        ax = (cropLeft ? s.left - 22 : s.right + 22) - base.left;
        ay = s.top + s.height / 2 - base.top;
        const end = cropLeft ? right : left;
        path = ay >= top && ay <= bottom ? `M${ax} ${ay} H${end}` : `M${ax} ${ay} H${(ax + end) / 2} V${top + height / 2} H${end}`;
      } else {
        const cropAbove = c.top + c.height / 2 < s.top;
        ax = (item.dataset.align === "right" ? s.right : s.left) - base.left;
        ay = (cropAbove ? s.top - 26 : s.bottom + 26) - base.top;
        const end = cropAbove ? bottom : top;
        path = ax >= left && ax <= right ? `M${ax} ${ay} V${end}` : `M${ax} ${ay} V${(ay + end) / 2} H${Math.min(Math.max(ax, left + 24), right - 24)} V${end}`;
      }

      dot.setAttribute("cx", String(ax));
      dot.setAttribute("cy", String(ay));
      line.setAttribute("d", path);
      box.setAttribute("x", String(left));
      box.setAttribute("y", String(top));
      box.setAttribute("width", String(Math.max(0, width)));
      box.setAttribute("height", String(Math.max(0, height)));

      if (drawn.has(item)) continue;
      const shown = Math.min(c.bottom, viewport) - Math.max(c.top, 0);
      if (shown < Math.min(c.height, viewport) * 0.5) continue;
      drawn.add(item);
      dot.style.opacity = "1";
      line.style.strokeDashoffset = "0";
      box.style.strokeDashoffset = "0";
    }
  }

  function frame() {
    const viewport = window.innerHeight;
    if (!still.matches) drift(viewport);
    ink(viewport);
  }

  window.addEventListener("scroll", frame, { passive: true });
  window.addEventListener("resize", frame);
  wide.addEventListener("change", frame);
  frame();
</script>
