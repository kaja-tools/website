---
/* The sideways strip. It runs to both edges of the page rather than stopping
   at the frame, so it reads as something to drag. The tallest crop is a
   portrait one, so the figures cap their height and crop from the top; the
   rest never reach the cap. */
const shots = [
  { src: "/assets/shot-scripts.png", width: 698, height: 516, caption: "Runs and scripts side by side in the sidebar." },
  { src: "/assets/shot-editor.png", width: 2297, height: 314, caption: "Typed imports for every connected app." },
  { src: "/assets/shot-run.png", width: 2297, height: 172, caption: "One run: its calls, or the canvas it drew." },
  { src: "/assets/shot-response.png", width: 1226, height: 304, caption: "Response, headers, status and duration per call." },
  { src: "/assets/shot-apps.png", width: 698, height: 961, caption: "Every app, service and method, one tree." },
];
---

<section class="pt-24 lg:pt-30">
  <div class="mx-auto w-full max-w-page px-6 md:px-8">
    <h2 data-reveal class="mb-3 font-display text-3xl/[1.1] font-semibold tracking-display md:text-title">A closer look</h2>
    <p data-reveal class="text-intro/[1.6] text-muted-foreground">Scroll sideways.</p>
  </div>

  <div class="flex snap-x snap-mandatory items-start gap-5 overflow-x-auto px-6 pt-8 pb-8 md:px-8" data-strip>
    {
      shots.map((shot) => (
        <figure class="m-0 w-[85vw] shrink-0 snap-center sm:w-130">
          <div class="overflow-hidden rounded-frame border border-border bg-card">
            <img
              src={shot.src}
              width={shot.width}
              height={shot.height}
              alt={shot.caption}
              loading="lazy"
              class="block h-auto max-h-110 w-full object-cover object-top"
            />
          </div>
          <figcaption class="mt-3 text-sm text-muted-foreground">{shot.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  /* The strip is the one thing on the site with a visible scrollbar, and it is
     the affordance that says it scrolls, so it is styled rather than hidden. */
  [data-strip] {
    scrollbar-width: thin;
    scrollbar-color: var(--color-muted) transparent;
  }

  [data-strip]::-webkit-scrollbar {
    height: 8px;
  }

  [data-strip]::-webkit-scrollbar-thumb {
    background: var(--color-muted);
    border-radius: 9999px;
  }
</style>
