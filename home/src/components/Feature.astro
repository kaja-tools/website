---
/* A card in the "what else it does" grid. The wrapper is what drifts as the
   page scrolls and the card is what fades in, so the two effects don't fight
   over one element's transform. */
interface Props {
  title: string;
  /* Share of the scroll past the card that it drifts by. Signs alternate down
     the grid, so the two columns pull against each other. */
  drift: number;
}

const { title, drift } = Astro.props;
---

<div data-parallax={drift} class="will-change-transform">
  <div data-reveal class="h-full rounded-xl border border-border bg-card p-7">
    <p class="mb-2.5 text-lede/[1.35] font-semibold tracking-tight">{title}</p>
    <div class="text-prose/[1.6] text-pretty text-muted-foreground"><slot /></div>
  </div>
</div>
