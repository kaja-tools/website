---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  icon: "code" | "package" | "server";
}

const { title, icon } = Astro.props;
---

<div class="rounded-lg border border-border bg-card p-6">
  <div class="mb-4 flex size-8 items-center justify-center rounded-md bg-muted">
    <Icon name={icon} />
  </div>
  <h3 class="mb-1.5 text-prose font-semibold">{title}</h3>
  <p class="text-sm/[1.6] text-muted-foreground"><slot /></p>
</div>
