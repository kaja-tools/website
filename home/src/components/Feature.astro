---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="rounded-2xl border border-white/5 bg-surface p-6 text-center transition-colors duration-200 hover:border-brand-purple/30 md:p-8">
  <div class="brand-gradient mx-auto mb-4 flex size-12 items-center justify-center rounded-xl [&_svg]:size-6 [&_svg]:text-white">
    <slot name="icon" />
  </div>
  <h3 class="mb-2 text-xl/[1.6] font-semibold">{title}</h3>
  <p class="text-[0.95rem] text-muted"><slot /></p>
</div>
