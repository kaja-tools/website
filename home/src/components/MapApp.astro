---
/* One of the four protocol cards, drawn from its own origin. 180x44 unless
   the layout needs it narrower. */
import type { ComponentProps } from "astro/types";
import Icon from "./Icon.astro";

interface Props {
  name: string;
  mark: ComponentProps<typeof Icon>["name"];
  source: string;
  width?: number;
}

const { name, mark, source, width = 180 } = Astro.props;
---

<rect {width} height="44" rx="8" class="fill-card stroke-muted-foreground" stroke-width="1.5"></rect>
<g transform="translate(14 12)" class="text-foreground">
  <Icon name={mark} size={20} />
</g>
<text x="44" y="26" font-size="13" font-weight="600" class="fill-foreground">{name}</text>
<text x={width - 14} y="26" text-anchor="end" font-size="11" class="fill-muted-foreground font-mono">{source}</text>
