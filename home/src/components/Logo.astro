---
/* The lockup: the gradient mark beside the wordmark. Inline rather than an
   <img> so the mark inherits nothing and the wordmark stays live text. */
---

<a href="/" class="flex items-center gap-2">
  <svg viewBox="0 8 48 32" fill="none" class="h-5.5 w-auto" aria-hidden="true">
    <defs>
      <linearGradient id="kaja-mark" x1="4" y1="24" x2="44" y2="24" gradientUnits="userSpaceOnUse">
        <stop stop-color="var(--color-brand-warm)"></stop>
        <stop offset="1" stop-color="var(--color-brand-cool)"></stop>
      </linearGradient>
    </defs>
    <path d="M4 29 H13 L19 13 L28 35 L33 24 H44" stroke="url(#kaja-mark)" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="font-display text-wordmark font-bold tracking-wordmark">Kaja</span>
</a>
