---
/* A run of statements, each next to the piece of the app it is about, with a
   red line drawn from the statement to a box around the thing itself. The
   items are passed in, because each section of the home page makes its own
   argument and brings the statements that belong to it, and `tone` is how
   loudly that section is allowed to make it.

   A crop is a frame with the item's screenshot as its background, scaled and
   positioned by `cropStyle` so the region is the part on show — arithmetic
   rather than a dozen image files, so a screen contributes as many close-ups
   as it has things to say.

   The connector and the box are drawn by Motion.astro, which is the only place
   on the site that reads the scroll. The geometry depends on where the two
   halves land, so it is measured rather than written down; without script the
   svg stays empty, which is what it should be — the crop and its statement
   already say the thing.  */
import type { Item } from "../data/poster";
import { cropMaxWidth, cropStyle } from "../data/shots";

/* `tone` is which level of the page the group belongs to. `lead` is the
   statement the section is making — the record, which is the argument the
   page turns on. `quiet` is everything supporting it: a size down and closer
   together, so five of them read as capabilities rather than as five more
   arguments. */
type Tone = "lead" | "quiet";

interface Props {
  items: Item[];
  tone?: Tone;
}

const { items, tone = "lead" } = Astro.props;

const run: Record<Tone, string> = {
  lead: "gap-24 pt-16 md:gap-40 md:pt-24",
  quiet: "gap-16 pt-10 md:gap-24 md:pt-14",
};

const statement: Record<Tone, string> = {
  lead: "text-poster",
  quiet: "text-poster-quiet",
};

/* The air inside an item, between the statement and the crop it points at.
   It closes up with the type, so a quiet item reads as one thing rather than
   as two loosely related ones. */
const gaps: Record<Tone, string> = {
  lead: "gap-y-8 md:gap-y-14",
  quiet: "gap-y-6 md:gap-y-9",
};
---

<div class:list={["flex flex-col", run[tone]]}>
  {
    items.map((item) => {
      const { crop, highlight, shot } = item;
      return (
        <div
          data-ink-item
          data-align={item.align}
          data-highlight={`${highlight.x},${highlight.y},${highlight.w},${highlight.h}`}
          class:list={["relative grid items-center md:grid-cols-12 md:gap-x-6", gaps[tone]]}
        >
          <div data-parallax={item.drift.statement} class:list={[item.statementCell, "will-change-transform"]}>
            <p
              data-statement
              class:list={["font-display font-semibold tracking-display text-balance", statement[tone], item.align === "right" ? "md:text-right" : "text-left"]}
            >
              {item.caption}
            </p>
          </div>

          <div data-parallax={item.drift.crop} class:list={[item.cropCell, "will-change-transform"]}>
            <div
              data-crop
              class="mx-auto rounded-xl border border-border bg-card bg-no-repeat shadow-crop"
              style={{ ...cropStyle(shot, crop), maxWidth: cropMaxWidth(shot, crop) }}
            />
          </div>

          <svg
            data-ink
            class="pointer-events-none absolute inset-0 h-full w-full overflow-visible stroke-ink"
            fill="none"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle data-dot r="3.5" class="fill-ink opacity-0" stroke="none" />
            <path data-line pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" d="M0 0" />
            <rect data-box pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" rx="4" x="0" y="0" width="0" height="0" />
          </svg>
        </div>
      );
    })
  }
</div>

<style>
  /* The line draws itself and the box lands after it, which is why the two
     timings differ. The dot is the end the line leaves from, so it arrives
     with it. All three are set by Motion.astro clearing the dash offset. */
  [data-dot] {
    transition: opacity 0.4s ease;
  }

  [data-line] {
    transition: stroke-dashoffset 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  [data-box] {
    transition: stroke-dashoffset 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.8s;
  }
</style>
