---
/* A block of the docs that belongs to one build. Each build is its own page,
   so a block that is not this page's is never rendered — the URL decides,
   and nothing is shipped hidden.

   One source file rather than two, because most of the docs is the same on
   both and a second page would fork every paragraph to keep two copies of
   four differences. If that balance ever tips, this is the seam to split on. */
import { platformOf, type Platform } from "../data/docs";

interface Props {
  only: Platform;
}

const { only } = Astro.props;
---

{platformOf(Astro.url) === only && <slot />}
