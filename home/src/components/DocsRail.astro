---
/* The docs' right column: one figure, of whichever section is being read on
   whichever platform was picked. The figures are stacked in a single grid
   cell and cross-faded by DocsMotion, so the rail never reflows and the copy
   beside it never moves. Decorative — the page reads whole without it, which
   is why it is the first column a narrow window drops, and why a section with
   nothing worth showing simply leaves it empty. */
import { sections } from "../data/docs";
import { cropStyle } from "../data/shots";
---

<div class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-100 items-center xl:flex" aria-hidden="true">
  <div class="grid w-full">
    {
      /* A figure carries the index of the section it belongs to and the
         platform it is for, rather than a position of its own, so a section
         with no figure needs nothing here. */
      sections.map((section, index) =>
        (section.figures ?? []).map((figure, order) => (
          <figure
            data-docs-shot={index}
            data-docs-shot-platform={figure.platform}
            class:list={[
              "col-start-1 row-start-1 m-0 self-center transition-[opacity,transform] duration-500 ease-[cubic-bezier(.2,.7,.2,1)]",
              /* The page opens on the first section and on Desktop, so that
                 figure is up before the script runs and the others are not. */
              index === 0 && order === 0 ? "opacity-100" : "opacity-0",
            ]}
          >
            <div class="overflow-hidden rounded-frame border border-border bg-card bg-no-repeat shadow-frame" style={cropStyle(figure.shot, figure.crop)} />
            <figcaption class="mt-2.5 text-fine/[1.5] text-muted-foreground">{figure.caption}</figcaption>
          </figure>
        )),
      )
    }
  </div>
</div>
