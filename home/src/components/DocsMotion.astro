---
/* The docs page's one scroll listener, and its one click handler — the same
   arrangement `Motion.astro` makes for the home page:

     data-docs-section   a section, read to work out which one is being read
     data-docs-link      its link in the sidebar, lit while it is
     data-platform-pick  the Desktop/Docker toggle

   The platform the page opens on is resolved by the boot script in
   `pages/docs.astro` — the `platform` query parameter, then what was picked
   last, then Desktop — so this reads it off the wrapper rather than working
   it out a second time.

   Nothing here moves: the sidebar's link lights on the section being read,
   and the screenshots are in the copy where they were written. */
---

<script>
  const wrap = document.querySelector<HTMLElement>("[data-docs-platform]");
  const sections = [...document.querySelectorAll<HTMLElement>("[data-docs-section]")];
  const links = [...document.querySelectorAll<HTMLElement>("[data-docs-link]")];
  const picks = [...document.querySelectorAll<HTMLButtonElement>("[data-platform-pick]")];

  const STORE = "kaja-docs-platform";

  function pick(platform: string, chosen = false) {
    if (!wrap) return;
    wrap.dataset.docsPlatform = platform;
    for (const button of picks) button.setAttribute("aria-pressed", String(button.dataset.platformPick === platform));
    try {
      localStorage.setItem(STORE, platform);
    } catch {
      // A browser that refuses storage still gets the toggle, just not the memory of it.
    }
    // A platform somebody picked belongs in the URL, so the link they copy
    // is the page they are reading. Replaced rather than pushed: the toggle
    // is not a navigation, and Back should leave the page.
    if (chosen) {
      const url = new URL(location.href);
      url.searchParams.set("platform", platform);
      history.replaceState(null, "", url);
    }
    // The blocks that appeared or went are above the fold as often as below
    // it, so where you are in the page has just changed.
    live = -1;
    spy();
  }

  for (const button of picks) button.addEventListener("click", () => pick(button.dataset.platformPick ?? "desktop", true));

  let live = -1;

  function spy() {
    if (!sections.length) return;

    // The section being read is the last one whose top has passed the upper
    // third of the window — near enough to where the eye sits, and it never
    // leaves the first section highlighted while its heading is off-screen.
    const mark = window.innerHeight * 0.42;
    let index = 0;
    sections.forEach((section, i) => {
      if (section.getBoundingClientRect().top <= mark) index = i;
    });
    if (index === live) return;
    live = index;

    links.forEach((link, i) => {
      if (i === index) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  }

  pick(wrap?.dataset.docsPlatform ?? "desktop");
  window.addEventListener("scroll", spy, { passive: true });
  window.addEventListener("resize", spy);
  spy();
</script>
