---
/* The docs page's one scroll listener — the same arrangement `Motion.astro`
   makes for the home page:

     data-docs-section   a section, read to work out which one is being read
     data-docs-link      its link in the sidebar, lit while it is
     data-platform-pick  the Desktop/Docker links

   Nothing here moves: the sidebar's link lights on the section being read,
   and the screenshots are in the copy where they were written.

   Which build the page is for is the URL now, so there is nothing to pick.
   What is left is that switching build is a navigation: the links carry the
   section being read, so the other build's page opens where this one was
   rather than at the top. */
---

<script>
  const sections = [...document.querySelectorAll<HTMLElement>("[data-docs-section]")];
  const links = [...document.querySelectorAll<HTMLElement>("[data-docs-link]")];
  const picks = [...document.querySelectorAll<HTMLAnchorElement>("[data-platform-pick]")];

  // The page each build link points at, kept apart from the section spy
  // appends, so the hash is replaced rather than piled onto.
  const pages = new Map(picks.map((pick) => [pick, pick.getAttribute("href") ?? ""]));

  let live = -2;

  function spy() {
    if (!sections.length) return;

    // The section being read is the last one whose top has passed the upper
    // third of the window — near enough to where the eye sits, and it never
    // leaves the first section highlighted while its heading is off-screen.
    // Above the first of them nothing has been reached, which is what -1 is.
    const mark = window.innerHeight * 0.42;
    let reached = -1;
    sections.forEach((section, i) => {
      if (section.getBoundingClientRect().top <= mark) reached = i;
    });
    if (reached === live) return;
    live = reached;

    const index = Math.max(reached, 0);
    links.forEach((link, i) => {
      if (i === index) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });

    // Still in the intro means there is no section to carry, and the other
    // build's page should open at its top.
    const id = reached < 0 ? "" : sections[reached].id;
    for (const pick of picks) pick.setAttribute("href", id ? `${pages.get(pick)}#${id}` : (pages.get(pick) ?? ""));
  }

  window.addEventListener("scroll", spy, { passive: true });
  window.addEventListener("resize", spy);
  spy();
</script>
