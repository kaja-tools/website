---
/* The icons the site uses, in the three families it draws them from.
   `lucide` are the 24px-grid outline icons kaja-ui ships, copied verbatim so
   the site and the app draw the same glyph. `marks` are kaja's own four
   protocol marks (`ui/src/protocolMarks.ts`), copied the same way — lucide has
   no gRPC, so the app draws them on lucide's grid and so does this. `brand`
   are the two marks the site links out with, which come as solid paths from
   their owners. */
const lucide = {
  search: '<path d="m21 21-4.34-4.34" /><circle cx="11" cy="11" r="8" />',
};

/* One node and what leaves it, four times over: gRPC is two nodes on a double
   rail, OpenAPI a node fanning to three paths, MCP a hexagon around a node,
   Twirp a node reaching one box. They have to read at 13px in muted grey. */
const marks = {
  grpc: '<circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="12" r="2.5" /><path d="M8.5 9.5h7M8.5 14.5h7" />',
  openapi:
    '<circle cx="6" cy="12" r="2.5" /><path d="M8.5 12h6M8.3 10.8 16 6M8.3 13.2 16 18" /><circle cx="18" cy="12" r="1.25" /><circle cx="18" cy="5" r="1.25" /><circle cx="18" cy="19" r="1.25" />',
  mcp: '<path d="M12 3l7.8 4.5v9L12 21l-7.8-4.5v-9z" /><circle cx="12" cy="12" r="2.5" />',
  twirp: '<circle cx="6" cy="12" r="2.5" /><path d="M8.5 12H15" /><rect x="15" y="8.5" width="5" height="7" rx="1" />',
};

const brand = {
  apple:
    '<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />',
  github:
    '<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />',
};

interface Props {
  name: keyof typeof lucide | keyof typeof marks | keyof typeof brand;
  /* Pixels, on lucide's terms: 16 inside a control, 40 in an empty state. */
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const glyph = { ...lucide, ...marks, ...brand }[name];
const outline = !(name in brand);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={outline ? "none" : "currentColor"}
  stroke={outline ? "currentColor" : undefined}
  stroke-width={outline ? 2 : undefined}
  stroke-linecap={outline ? "round" : undefined}
  stroke-linejoin={outline ? "round" : undefined}
  class={className}
  aria-hidden="true"
  set:html={glyph}
/>
