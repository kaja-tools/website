---
/* Kaja drawn as its own canvas, from its own origin. 200x180. */
---

<g class="stroke-muted-foreground" stroke-width="1.5">
  <rect width="200" height="180" rx="8" class="fill-card stroke-muted-foreground"></rect>
  <path d="M0 30h200"></path>
</g>
{
  /* The Kaja mark at the size this drawing can carry it, in stroke rather than
    in its gradient: the map has three weights and no colour. */
}
<path d="M16 15h5l3-6 4 12 3-6h5" stroke-width="2" class="stroke-foreground"></path>
<text x="44" y="19" font-size="13" font-weight="600" class="fill-foreground">Kaja</text>
<text x="184" y="19" text-anchor="end" font-size="10" class="fill-muted-foreground">canvas</text>
<g class="stroke-wire" stroke-width="1.5">
  <path d="M18 50h96M18 62h64"></path>
  <rect x="18" y="78" width="164" height="42" rx="3"></rect>
  <path d="M18 92h164M73 78v42M128 78v42"></path>
  <rect x="18" y="134" width="164" height="30" rx="3"></rect>
</g>
<g class="stroke-muted-foreground" stroke-width="1.5">
  <path d="M30 149h4l2-4 3 8 2-4h4"></path>
  <path d="M54 149h78"></path>
  <path d="M156 145l3 4 6-8"></path>
</g>
