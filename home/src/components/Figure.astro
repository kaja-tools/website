---
/* A screenshot in the run of the docs: a crop of one of the shots, framed.
   It sits in the copy under the paragraph it belongs to rather than in a
   column of its own, so a section with nothing worth showing simply has none.
   A caption is for what the picture does not say itself; most have none.

   A crop is read at the width of the column here, so it can hold a whole
   dialog. A crop taller than it is wide is capped by `--size-figure` instead,
   which is why the width is arithmetic on the aspect `cropStyle` worked out
   rather than a second number to keep in step. */
import { cropStyle, type Crop, type Shot } from "../data/shots";

interface Props {
  shot: Shot;
  /* The whole shot when absent. */
  crop?: Crop;
  caption?: string;
}

const { shot, crop, caption } = Astro.props;
const region = cropStyle(shot, crop);
---

<figure class="mt-8" style={`max-width: calc(var(--size-figure) * ${region.aspectRatio})`}>
  <div class="overflow-hidden rounded-frame border border-border bg-card bg-no-repeat shadow-frame" style={region}></div>
  {caption && <figcaption class="mt-2.5 text-fine/[1.5] text-muted-foreground">{caption}</figcaption>}
</figure>
