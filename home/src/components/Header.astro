---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const link = "text-sm text-muted-foreground transition-colors hover:text-foreground";
const current = "text-foreground";

const onPrivacy = Astro.url.pathname.startsWith("/privacy");
---

<header class="flex h-14 items-center justify-between border-b border-border px-6 md:px-8">
  <Logo />
  <nav class="flex items-center gap-4 sm:gap-5">
    <a href="https://demo.kaja.tools/" class:list={[link, "hidden xs:block"]}>Demo</a>
    <a href="/privacy" class:list={[link, onPrivacy && current]} aria-current={onPrivacy ? "page" : undefined}>Privacy</a>
    <a href="https://github.com/wham/kaja" class:list={[link, "flex items-center gap-2"]} target="_blank" rel="noopener">
      <Icon name="github" />
      <span class="hidden sm:inline">GitHub</span>
    </a>
    <Button href="https://apps.apple.com/us/app/kaja-for-grpc-and-twirp/id6761604205?mt=12" size="sm" target="_blank" rel="noopener">Download</Button>
  </nav>
</header>
