---
import GitHubIcon from "./GitHubIcon.astro";
---

<header class="mx-auto flex w-full max-w-page items-center justify-between px-6 py-4 md:px-8 md:py-6">
  <a href="/" class="flex items-center">
    <img src="/logo.svg" alt="Kaja" class="h-10 w-auto" />
  </a>
  <nav class="flex items-center gap-6">
    <a
      href="https://github.com/wham/kaja"
      class="flex items-center gap-2 text-[0.95rem] font-medium text-muted transition-colors duration-200 hover:text-white"
      target="_blank"
      rel="noopener"
    >
      <GitHubIcon class="size-5" />
      GitHub
    </a>
  </nav>
</header>
